package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "devicehealthd-defaults",
    shared_libs: [
        "android.devicehealth-V1-ndk",
        "android.hardware.devicehealth-V1-ndk",
        "libbinder_ndk",
        "libcutils",
        "liblog",
    ],
    static_libs: ["libbase"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    min_sdk_version: "34",
    apex_available: ["com.android.devicehealth"],
}

cc_library_static {
    name: "libdevicehealthservice",
    defaults: ["devicehealthd-defaults"],
    export_include_dirs: ["."],
    srcs: [
        "DeviceHealthService.cpp",
        "MemoryProvider.cpp",
        "ThermalProvider.cpp",
    ],
}

cc_binary {
    name: "devicehealthd",
    defaults: ["devicehealthd-defaults"],
    srcs: ["main.cpp"],
    static_libs: ["libdevicehealthservice"],
}
