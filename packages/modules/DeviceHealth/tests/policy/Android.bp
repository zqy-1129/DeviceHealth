package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Host-side JUnit tests for the production PolicyEngine source.
// The local android/devicehealth classes are compile-time stand-ins; they are not shipped.
java_test_host {
    name: "devicehealth-policy-tests",
    srcs: [
        ":devicehealth-policy-engine-srcs",
        "src/**/*.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
