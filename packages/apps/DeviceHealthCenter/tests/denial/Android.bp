package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Privileged so it can find the service, but intentionally not granted
// MANAGE_DEVICE_HEALTH: it is neither platform-signed nor allowlisted.
android_app {
    name: "DeviceHealthDenialTest",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    sdk_version: "system_current",
    privileged: true,
    min_sdk_version: "34",
    target_sdk_version: "34",
    optimize: {
        enabled: false,
    },
}
