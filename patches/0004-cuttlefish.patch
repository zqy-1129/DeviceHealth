+
+type hal_devicehealth_default, domain;
+type hal_devicehealth_default_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(hal_devicehealth_default);
+hal_server_domain(hal_devicehealth_default, hal_devicehealth);
+
+# Read thermal zone type and temperature files.
+# /sys/class/thermal itself is labeled sysfs; the zone entries are sysfs_thermal.
+allow hal_devicehealth_default sysfs:dir r_dir_perms;
+r_dir_file(hal_devicehealth_default, sysfs_thermal)
