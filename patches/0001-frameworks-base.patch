+        @Override
+        protected void dump(FileDescriptor fd, PrintWriter pw, String[] args) {
+            if (!DumpUtils.checkDumpPermission(getContext(), TAG, pw)) {
+                return;
+            }
+            if (args != null && args.length > 0) {
+                if ("simulate-critical".equals(args[0])) {
+                    addSimulatedCriticalEvent(pw);
+                    return;
+                }
+                if ("simulate-metric".equals(args[0]) && args.length >= 3) {
+                    try {
+                        float value = Float.parseFloat(args[2]);
+                        synchronized (mLock) {
+                            mSimulatedValues.put(args[1], value);
+                        }
+                        refresh();
+                        pw.println("Simulated " + args[1] + " = " + value);
+                    } catch (NumberFormatException e) {
+                        pw.println("Usage: dumpsys devicehealth simulate-metric <id> <value>");
+                    }
+                    return;
+                }
+                if ("clear-simulated".equals(args[0])) {
+                    synchronized (mLock) {
+                        mSimulatedValues.clear();
+                    }
+                    refresh();
+                    pw.println("Cleared simulated metric overrides");
+                    return;
+                }
+            }
+
+            refresh();
+            DeviceHealthDaemonInfo daemonInfo = queryDaemonInfo();
+            synchronized (mLock) {
+                if (mLastSnapshot == null) {
+                    pw.println("DeviceHealth Service: not initialized");
+                    return;
+                }
+                long now = SystemClock.elapsedRealtime();
+                pw.println("DeviceHealth Service");
+                pw.println("  state: "
+                        + PolicyEngine.severityName(mLastSnapshot.getOverallSeverity()));
+                pw.println("  last update: "
+                        + Math.max(0, now - mLastSnapshot.getTimestampMs()) + "ms ago");
+                pw.println("  stale: " + mLastSnapshot.isStale());
+                pw.println("  daemon: " + (mDaemon != null ? "connected" : "unavailable")
+                        + " version=" + mLastSnapshot.getDaemonVersion()
+                        + " capabilities=0x"
+                        + Integer.toHexString(mLastSnapshot.getCapabilities()));
+                pw.println("  compatibility: " + compatibilityName(daemonInfo.getCompatibility())
+                        + " (supported " + MIN_DAEMON_VERSION + ".." + MAX_DAEMON_VERSION + ")");
+                if (mDaemonVersionOverride >= 0) {
+                    pw.println("  daemon version override: " + mDaemonVersionOverride
+                            + " (debug)");
+                }
+                pw.println("  listeners: " + mListeners.getRegisteredCallbackCount());
+                pw.println("  watchdog: " + (mEvaluationStallReported ? "STALLED" : "ok")
+                        + " (last evaluation took " + mLastEvaluationDurationMs
+                        + "ms, " + (mLastEvaluationEndMs <= 0 ? -1 : now - mLastEvaluationEndMs)
+                        + "ms ago, trips " + mWatchdogTrips.get()
+                        + ", recoveries " + mWatchdogRecoveries.get()
+                        + ", daemon timeouts " + mDaemonTimeouts.get() + ")");
+                pw.println("  last rejected sample: "
+                        + (mLastRejectedSample.isEmpty() ? "none" : mLastRejectedSample));
+                pw.println("  evaluations: " + mEvaluationCount);
+                pw.println("  events: " + mEvents.size());
+                if (!mSimulatedValues.isEmpty()) {
+                    pw.println("  simulated overrides: " + mSimulatedValues);
+                }
+                pw.println();
+
+                pw.println("Snapshot");
+                for (DeviceHealthMetric metric : mLastSnapshot.getMetrics()) {
+                    pw.println("  " + metric.getId() + ": " + metric.getValue() + " "
+                            + metric.getUnit() + (metric.isSimulated() ? " (simulated)" : ""));
+                }
+                pw.println();
+
+                pw.println("Thresholds");
+                for (Map.Entry<String, PolicyEngine.Thresholds> entry
+                        : mPolicyEngine.getThresholds().entrySet()) {
+                    pw.println("  " + entry.getKey() + ": " + entry.getValue().describe());
+                }
+                pw.println();
+
+                pw.println("Recent Events");
+                if (mEvents.isEmpty()) {
+                    pw.println("  none");
+                } else {
+                    for (DeviceHealthEvent event : mEvents) {
+                        pw.println("  #" + event.getEventId() + " " + event.getMessage());
+                    }
+                }
+                pw.println();
+
+                pw.println("Last Error");
+                String lastError = daemonInfo.getLastError();
+                pw.println("  " + (lastError.isEmpty() ? "none" : lastError));
+                pw.println();
+
+                pw.println("Binder Calls");
+                List<String> statNames = new ArrayList<>(mCallStats.keySet());
+                Collections.sort(statNames);
+                if (statNames.isEmpty()) {
+                    pw.println("  none");
+                } else {
+                    for (String name : statNames) {
