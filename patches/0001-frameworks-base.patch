+package android.devicehealth;
+
+import android.annotation.NonNull;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * A point-in-time snapshot of device health.
+ *
+ * @hide
+ */
+@SystemApi
+public final class DeviceHealthSnapshot implements Parcelable {
+    public static final int SEVERITY_NORMAL = 0;
+    public static final int SEVERITY_WARNING = 1;
+    public static final int SEVERITY_CRITICAL = 2;
+    public static final int SEVERITY_STALE = 3;
+    public static final int SEVERITY_UNKNOWN = 4;
+
+    private final List<DeviceHealthMetric> mMetrics;
+    private final int mOverallSeverity;
+    private final long mTimestampMs;
+    private final boolean mStale;
+    private final int mDaemonVersion;
+    private final int mCapabilities;
+
+    public DeviceHealthSnapshot(@NonNull List<DeviceHealthMetric> metrics, int overallSeverity,
+            long timestampMs, boolean stale, int daemonVersion, int capabilities) {
+        mMetrics = Collections.unmodifiableList(new ArrayList<>(metrics));
+        mOverallSeverity = overallSeverity;
+        mTimestampMs = timestampMs;
+        mStale = stale;
+        mDaemonVersion = daemonVersion;
+        mCapabilities = capabilities;
+    }
+
+    private DeviceHealthSnapshot(Parcel in) {
+        List<DeviceHealthMetric> metrics = in.createTypedArrayList(DeviceHealthMetric.CREATOR);
+        mMetrics = metrics == null ? Collections.emptyList() : Collections.unmodifiableList(metrics);
+        mOverallSeverity = in.readInt();
+        mTimestampMs = in.readLong();
+        mStale = in.readBoolean();
+        mDaemonVersion = in.readInt();
+        mCapabilities = in.readInt();
+    }
+
+    public static final @NonNull Creator<DeviceHealthSnapshot> CREATOR =
+            new Creator<DeviceHealthSnapshot>() {
+                @Override
+                public DeviceHealthSnapshot createFromParcel(Parcel in) {
+                    return new DeviceHealthSnapshot(in);
+                }
+
+                @Override
+                public DeviceHealthSnapshot[] newArray(int size) {
+                    return new DeviceHealthSnapshot[size];
+                }
+            };
+
+    @Override
+    public int describeContents() {
+        return 0;
+    }
+
+    @Override
+    public void writeToParcel(@NonNull Parcel dest, int flags) {
+        dest.writeTypedList(mMetrics);
+        dest.writeInt(mOverallSeverity);
+        dest.writeLong(mTimestampMs);
+        dest.writeBoolean(mStale);
+        dest.writeInt(mDaemonVersion);
+        dest.writeInt(mCapabilities);
+    }
+
+    public @NonNull List<DeviceHealthMetric> getMetrics() {
+        return mMetrics;
+    }
+
+    public int getOverallSeverity() {
+        return mOverallSeverity;
+    }
+
+    public long getTimestampMs() {
+        return mTimestampMs;
+    }
+
+    public boolean isStale() {
+        return mStale;
+    }
+
+    public int getDaemonVersion() {
+        return mDaemonVersion;
+    }
+
+    public int getCapabilities() {
+        return mCapabilities;
+    }
+}
