+    private List<DeviceHealthMetric> convertMetrics(MetricSample[] samples, long nowMs) {
+        List<DeviceHealthMetric> metrics = new ArrayList<>();
+        String rejected = "";
+        if (samples != null) {
+            for (MetricSample sample : samples) {
+                Float override = mSimulatedValues.get(sample.id);
+                float value = override != null ? override : sample.value;
+                long timestampMs = override != null ? nowMs : sample.timestampMs;
+                boolean simulated = override != null || sample.simulated;
+                String problem = validateSample(sample.id, value);
+                if (problem != null) {
+                    rejected = describeRejectedSample(sample.id, value, sample.unit, problem);
+                    DeviceHealthMetric previous = findLastMetric(sample.id);
+                    if (previous != null) {
+                        metrics.add(previous);
+                    }
+                    continue;
+                }
+                metrics.add(new DeviceHealthMetric(sample.id, sample.name, value, sample.unit,
+                        timestampMs, simulated));
+            }
+        }
+
+        // Overrides for metrics the daemon does not report (for example when the HAL is absent).
+        for (Map.Entry<String, Float> entry : mSimulatedValues.entrySet()) {
+            boolean present = false;
+            for (DeviceHealthMetric metric : metrics) {
+                if (metric.getId().equals(entry.getKey())) {
+                    present = true;
+                    break;
+                }
+            }
+            if (!present) {
+                String unit = entry.getKey().startsWith("thermal.") ? "C" : "percent";
+                String problem = validateSample(entry.getKey(), entry.getValue());
+                if (problem != null) {
+                    rejected = describeRejectedSample(entry.getKey(), entry.getValue(), unit,
+                            problem);
+                    continue;
+                }
+                metrics.add(new DeviceHealthMetric(entry.getKey(), entry.getKey(),
+                        entry.getValue(), unit, nowMs, /*simulated=*/true));
+            }
+        }
+        updateRejectedSampleLocked(rejected);
+        return metrics;
+    }
+
+    private DeviceHealthMetric findLastMetric(String id) {
+        for (DeviceHealthMetric metric : mLastMetrics) {
+            if (metric.getId().equals(id)) {
+                return metric;
+            }
+        }
+        return null;
+    }
+
+    private static String validateSample(String id, float value) {
+        if (!Float.isFinite(value)) {
+            return "non-finite value";
+        }
+        if (id.startsWith("thermal.")) {
+            if (value < THERMAL_MIN_C || value > THERMAL_MAX_C) {
+                return "outside [" + (int) THERMAL_MIN_C + ", " + (int) THERMAL_MAX_C + "] C";
+            }
+        } else if ("memory.pressure".equals(id)) {
+            if (value < MEMORY_MIN_PERCENT || value > MEMORY_MAX_PERCENT) {
+                return "outside [0, 100] percent";
+            }
+        }
+        return null;
+    }
+
+    private static String describeRejectedSample(String id, float value, String unit,
+            String problem) {
+        return id + "=" + value + " " + unit + " (" + problem + ")";
+    }
+
+    /** Called with {@link #mLock} held from {@link #convertMetrics}. */
+    private void updateRejectedSampleLocked(String rejected) {
+        if (rejected.isEmpty()) {
+            mLastRejectedSample = "";
+            return;
+        }
+        long now = SystemClock.elapsedRealtime();
+        if (!rejected.equals(mLastRejectedSample) || now - mLastRejectedLogMs > 10_000) {
+            mLastRejectedLogMs = now;
+            Slog.w(TAG, "Rejected metric sample: " + rejected);
+        }
+        mLastRejectedSample = rejected;
+    }
+
+    private void postCriticalNotification(DeviceHealthEvent event) {
+        long token = Binder.clearCallingIdentity();
+        try {
+            ensureNotificationChannel();
+            if (mNotificationManager == null || !mChannelCreated) {
+                Slog.w(TAG, "Cannot post critical notification: notification manager unavailable");
+                return;
+            }
+            Intent intent = new Intent(Intent.ACTION_MAIN);
+            intent.setClassName(APP_PACKAGE, APP_ACTIVITY);
+            intent.putExtra("event_id", event.getEventId());
+            intent.putExtra("event_message", event.getMessage());
+            intent.putExtra("metric_id", event.getMetricId());
+            intent.putExtra("severity", event.getToSeverity());
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+
+            PendingIntent pendingIntent = PendingIntent.getActivity(getContext(),
+                    event.getEventId(), intent,
+                    PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+
+            Notification notification = new Notification.Builder(getContext(), CHANNEL_ID)
+                    .setSmallIcon(android.R.drawable.stat_notify_error)
+                    .setContentTitle("Device health critical")
+                    .setContentText(event.getMessage())
+                    .setStyle(new Notification.BigTextStyle().bigText(event.getMessage()))
+                    .setCategory(Notification.CATEGORY_ALARM)
+                    .setAutoCancel(true)
+                    .setContentIntent(pendingIntent)
+                    .build();
+            mNotificationManager.notify(NOTIFICATION_TAG, event.getEventId(), notification);
+            Slog.i(TAG, "Posted critical notification for event " + event.getEventId());
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    private DeviceHealthDaemonInfo queryDaemonInfo() {
+        IDeviceHealthService daemon = getDaemon();
+        if (daemon == null) {
+            return new DeviceHealthDaemonInfo(0, 0, 0, "devicehealthd unavailable",
+                    DeviceHealthDaemonInfo.COMPATIBILITY_UNAVAILABLE);
+        }
+        DaemonInfoResult result = fetchDaemonInfo(daemon);
+        if (result.info == null) {
+            synchronized (mLock) {
+                dropDaemonLocked();
+            }
+            return new DeviceHealthDaemonInfo(0, 0, 0, "devicehealthd unavailable",
+                    DeviceHealthDaemonInfo.COMPATIBILITY_UNAVAILABLE);
+        }
+        DaemonInfo info = result.info;
+        int effectiveVersion = effectiveDaemonVersion(info.interfaceVersion);
+        return new DeviceHealthDaemonInfo(info.interfaceVersion, info.capabilities, info.pid,
+                info.lastError, compatibilityOf(effectiveVersion));
+    }
+
+    private boolean isDaemonDegraded() {
+        synchronized (mLock) {
+            int override = mDaemonVersionOverride;
+            if (mDaemon == null && override < 0) {
+                return false;
+            }
+            int version;
+            if (override >= 0) {
+                version = override;
+            } else if (mLastSnapshot != null) {
+                version = mLastSnapshot.getDaemonVersion();
+            } else {
+                version = 0;
+            }
+            return compatibilityOf(version) == DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD;
+        }
+    }
+
+    private void ensureNotDegraded() {
+        if (isDaemonDegraded()) {
+            throw new IllegalStateException(
+                    "Daemon interface version is below the supported minimum; feature disabled");
+        }
+    }
+
+    private void armCriticalSimulation(String metricId) {
+        PolicyEngine.Thresholds thresholds = mPolicyEngine.thresholdsFor(metricId);
+        if (thresholds == null) {
+            throw new IllegalArgumentException("Unsupported metric: " + metricId);
+        }
+        float value = thresholds.criticalEnter + 5.0f;
+        synchronized (mLock) {
+            mSimulatedValues.put(metricId, value);
+        }
+        refresh();
+    }
+
+    private void clearSimulatedMetrics() {
+        synchronized (mLock) {
+            mSimulatedValues.clear();
+        }
+        refresh();
+    }
+
+    private void clearEventsInternal() {
+        List<Integer> notificationIds = new ArrayList<>();
+        synchronized (mLock) {
+            for (DeviceHealthEvent event : mEvents) {
+                notificationIds.add(event.getEventId());
+            }
+            mEvents.clear();
+        }
+        if (mNotificationManager != null && !notificationIds.isEmpty()) {
+            long token = Binder.clearCallingIdentity();
+            try {
+                for (int id : notificationIds) {
+                    mNotificationManager.cancel(NOTIFICATION_TAG, id);
+                }
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
+        }
+    }
+
+    private void enforceDebuggable() {
+        if (!Build.IS_DEBUGGABLE) {
+            throw new SecurityException("Simulation is only available on debuggable builds");
+        }
+    }
+
+    private void addSimulatedCriticalEvent(PrintWriter pw) {
+        DeviceHealthEvent event;
+        synchronized (mLock) {
+            event = new DeviceHealthEvent(mNextEventId++, "thermal.cpu",
+                    DeviceHealthSnapshot.SEVERITY_WARNING,
+                    DeviceHealthSnapshot.SEVERITY_CRITICAL, 78.0f, 75.0f,
+                    SystemClock.elapsedRealtime(),
+                    "thermal.cpu: simulated critical (78.0 C, threshold 75.0)");
+            mEvents.addFirst(event);
+            while (mEvents.size() > MAX_EVENTS) {
+                mEvents.removeLast();
+            }
+        }
+        long token = Binder.clearCallingIdentity();
+        try {
+            postCriticalNotification(event);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+        pw.println("Simulated critical event #" + event.getEventId());
+    }
+
+    private DeviceHealthSnapshot currentSnapshot() {
+        boolean needsRefresh;
+        synchronized (mLock) {
+            needsRefresh = mLastSnapshot == null;
+        }
+        if (needsRefresh) {
+            refresh();
+        }
+        synchronized (mLock) {
+            if (mLastSnapshot != null) {
+                return mLastSnapshot;
+            }
+            return new DeviceHealthSnapshot(Collections.emptyList(),
+                    DeviceHealthSnapshot.SEVERITY_UNKNOWN, SystemClock.elapsedRealtime(),
+                    /*stale=*/true, /*daemonVersion=*/0, /*capabilities=*/0);
+        }
+    }
