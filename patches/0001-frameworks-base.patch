+
+package android.devicehealth;
+
+import android.annotation.NonNull;
+import android.annotation.SuppressLint;
+import android.annotation.SystemApi;
+
+/**
+ * Receives device health updates pushed by {@link DeviceHealthManager}.
+ *
+ * <p>Callbacks are delivered on the {@link java.util.concurrent.Executor} passed to
+ * {@link DeviceHealthManager#registerListener}. Listener implementations must not block,
+ * because callbacks are serialized by the framework.
+ *
+ * @hide
+ */
+@SystemApi
+@SuppressLint("UnflaggedApi")
+public interface DeviceHealthListener {
+    /**
+     * Called when a new snapshot has been evaluated.
+     */
+    @SuppressLint("UnflaggedApi")
+    void onSnapshotChanged(@NonNull DeviceHealthSnapshot snapshot);
+
+    /**
+     * Called for every health event produced by a policy transition.
+     */
+    @SuppressLint("UnflaggedApi")
+    void onEvent(@NonNull DeviceHealthEvent event);
+}
