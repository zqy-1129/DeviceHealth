+package android.devicehealth;
+
+import android.annotation.NonNull;
+import android.annotation.SuppressLint;
+import android.annotation.SystemApi;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+/**
+ * Diagnostic information about the device health daemon.
+ *
+ * @hide
+ */
+@SystemApi
+@SuppressLint("UnflaggedApi")
+public final class DeviceHealthDaemonInfo implements Parcelable {
+    /** The daemon interface version is supported by this framework build. */
+    @SuppressLint("UnflaggedApi")
+    public static final int COMPATIBILITY_OK = 0;
+    /** The daemon interface version is older than the minimum supported version. */
+    @SuppressLint("UnflaggedApi")
+    public static final int COMPATIBILITY_TOO_OLD = 1;
+    /** The daemon is newer than the versions this framework build was tested with. */
+    @SuppressLint("UnflaggedApi")
+    public static final int COMPATIBILITY_NEWER = 2;
+    /** The daemon is not registered, so compatibility cannot be evaluated. */
+    @SuppressLint("UnflaggedApi")
+    public static final int COMPATIBILITY_UNAVAILABLE = 3;
+
+    private final int mInterfaceVersion;
+    private final int mCapabilities;
+    private final int mPid;
+    private final String mLastError;
+    private final int mCompatibility;
+
+    @SuppressLint("UnflaggedApi")
+    public DeviceHealthDaemonInfo(int interfaceVersion, int capabilities, int pid,
+            @NonNull String lastError, int compatibility) {
+        mInterfaceVersion = interfaceVersion;
+        mCapabilities = capabilities;
+        mPid = pid;
+        mLastError = lastError;
+        mCompatibility = compatibility;
+    }
+
+    private DeviceHealthDaemonInfo(Parcel in) {
+        mInterfaceVersion = in.readInt();
+        mCapabilities = in.readInt();
+        mPid = in.readInt();
+        mLastError = in.readString();
+        mCompatibility = in.readInt();
+    }
+
