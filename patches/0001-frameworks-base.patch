+package com.android.server.devicehealth;
+
+import android.devicehealth.DeviceHealthMetric;
+import android.devicehealth.DeviceHealthSnapshot;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Threshold, hysteresis, debounce and staleness policy for device health metrics.
+ *
+ * <p>Each metric owns an independent state machine. Events are only produced on
+ * state transitions, and a metric that stops producing fresh samples moves to
+ * {@code STALE} and eventually {@code UNKNOWN}.
+ */
+final class PolicyEngine {
+    static final long STALE_AFTER_MS = 10_000;
+    static final long UNKNOWN_AFTER_MS = 30_000;
+    private static final long MIN_EVENT_INTERVAL_MS = 2_000;
+
+    static final class Thresholds {
+        final float warningEnter;
+        final float warningClear;
+        final float criticalEnter;
+        final float criticalClear;
+        final int debounceSamples;
+
+        Thresholds(float warningEnter, float warningClear, float criticalEnter,
+                float criticalClear, int debounceSamples) {
+            this.warningEnter = warningEnter;
+            this.warningClear = warningClear;
+            this.criticalEnter = criticalEnter;
+            this.criticalClear = criticalClear;
+            this.debounceSamples = debounceSamples;
+        }
+
+        String describe() {
+            return String.format(Locale.US,
+                    "warn %.1f/%.1f crit %.1f/%.1f debounce %d",
+                    warningEnter, warningClear, criticalEnter, criticalClear, debounceSamples);
+        }
+    }
+
+    static final class Transition {
+        final String metricId;
+        final int fromSeverity;
+        final int toSeverity;
+        final float value;
+        final float threshold;
+        final String message;
+
+        Transition(String metricId, int fromSeverity, int toSeverity, float value, float threshold,
+                String message) {
+            this.metricId = metricId;
+            this.fromSeverity = fromSeverity;
+            this.toSeverity = toSeverity;
+            this.value = value;
+            this.threshold = threshold;
+            this.message = message;
+        }
+    }
+
+    static final class Result {
+        final int overallSeverity;
+        final List<Transition> transitions;
+
+        Result(int overallSeverity, List<Transition> transitions) {
+            this.overallSeverity = overallSeverity;
+            this.transitions = transitions;
+        }
+    }
+
+    private static final class MetricState {
+        int severity = DeviceHealthSnapshot.SEVERITY_UNKNOWN;
+        int pendingSeverity = DeviceHealthSnapshot.SEVERITY_UNKNOWN;
+        int pendingCount;
+        long lastEventMs;
+        long lastValueTimestampMs = Long.MIN_VALUE;
+        boolean hasValue;
+    }
+
+    private final Map<String, Thresholds> mDefaults = new LinkedHashMap<>();
+    private final Map<String, Thresholds> mThresholds = new LinkedHashMap<>();
+    private final Map<String, MetricState> mStates = new HashMap<>();
+    private long mLastValidSampleMs = -1;
+
+    PolicyEngine() {
+        mDefaults.put("thermal.", new Thresholds(65.0f, 60.0f, 75.0f, 70.0f, 3));
+        mDefaults.put("memory.pressure", new Thresholds(80.0f, 75.0f, 92.0f, 85.0f, 3));
+        mThresholds.putAll(mDefaults);
+    }
+
+    synchronized Map<String, Thresholds> getThresholds() {
+        return new LinkedHashMap<>(mThresholds);
+    }
+
+    /**
+     * Validates a threshold configuration and returns a human-readable error, or
+     * {@code null} when the configuration is usable.
+     */
+    static String validateThresholds(float warningEnter, float warningClear, float criticalEnter,
+            float criticalClear, int debounceSamples) {
+        if (!Float.isFinite(warningEnter) || !Float.isFinite(warningClear)
+                || !Float.isFinite(criticalEnter) || !Float.isFinite(criticalClear)) {
+            return "thresholds must be finite numbers";
+        }
+        if (warningClear >= warningEnter) {
+            return "warningClear (" + warningClear + ") must be lower than warningEnter ("
+                    + warningEnter + ")";
+        }
+        if (criticalClear >= criticalEnter) {
+            return "criticalClear (" + criticalClear + ") must be lower than criticalEnter ("
+                    + criticalEnter + ")";
+        }
+        if (criticalEnter < warningEnter) {
+            return "criticalEnter (" + criticalEnter + ") must not be lower than warningEnter ("
+                    + warningEnter + ")";
+        }
+        if (debounceSamples < 1 || debounceSamples > 20) {
+            return "debounce must be between 1 and 20 samples";
+        }
+        return null;
+    }
+
+    synchronized void setThresholds(String key, Thresholds thresholds) {
+        mThresholds.put(key, thresholds);
+    }
+
+    synchronized void resetThresholds() {
+        mThresholds.clear();
+        mThresholds.putAll(mDefaults);
+    }
+
+    /**
+     * Evaluates a fresh snapshot. Metrics without a configured threshold stay
+     * {@code NORMAL} and never generate events.
+     */
+    synchronized Result evaluate(List<DeviceHealthMetric> metrics, long nowMs) {
+        List<Transition> transitions = new ArrayList<>();
+        if (metrics == null || metrics.isEmpty()) {
+            return onDataUnavailable(nowMs);
+        }
+
+        boolean anyUnknown = false;
+        boolean anyStale = false;
+        boolean anyCritical = false;
+        boolean anyWarning = false;
+
+        for (DeviceHealthMetric metric : metrics) {
+            Thresholds thresholds = thresholdsFor(metric.getId());
+            if (thresholds == null) {
+                continue;
+            }
+            MetricState state = mStates.computeIfAbsent(metric.getId(), key -> new MetricState());
+            long timestampMs = metric.getTimestampMs();
+            if (timestampMs > mLastValidSampleMs) {
+                mLastValidSampleMs = timestampMs;
+            }
+
+            long ageMs = nowMs - timestampMs;
+            if (ageMs >= UNKNOWN_AFTER_MS) {
+                applyImmediate(state, metric.getId(), DeviceHealthSnapshot.SEVERITY_UNKNOWN, 0.0f,
+                        0.0f, "no fresh sample for " + ageMs / 1000 + "s", nowMs, transitions);
+            } else if (ageMs >= STALE_AFTER_MS) {
+                applyImmediate(state, metric.getId(), DeviceHealthSnapshot.SEVERITY_STALE, 0.0f,
+                        0.0f, "no fresh sample for " + ageMs / 1000 + "s", nowMs, transitions);
+            } else if (!state.hasValue || timestampMs != state.lastValueTimestampMs) {
+                state.hasValue = true;
+                state.lastValueTimestampMs = timestampMs;
+                evaluateSample(state, metric, thresholds, nowMs, transitions);
+            }
+
+            switch (state.severity) {
+                case DeviceHealthSnapshot.SEVERITY_CRITICAL:
+                    anyCritical = true;
+                    break;
+                case DeviceHealthSnapshot.SEVERITY_WARNING:
+                    anyWarning = true;
+                    break;
+                case DeviceHealthSnapshot.SEVERITY_STALE:
+                    anyStale = true;
+                    break;
+                case DeviceHealthSnapshot.SEVERITY_UNKNOWN:
+                    anyUnknown = true;
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        int overall;
+        if (anyCritical) {
+            overall = DeviceHealthSnapshot.SEVERITY_CRITICAL;
+        } else if (anyUnknown) {
+            overall = DeviceHealthSnapshot.SEVERITY_UNKNOWN;
+        } else if (anyStale) {
+            overall = DeviceHealthSnapshot.SEVERITY_STALE;
+        } else if (anyWarning) {
+            overall = DeviceHealthSnapshot.SEVERITY_WARNING;
+        } else {
+            overall = DeviceHealthSnapshot.SEVERITY_NORMAL;
+        }
+        return new Result(overall, transitions);
+    }
+
+    /**
+     * Handles the case where the daemon is unreachable or returns no metrics.
+     * Known metrics move to {@code STALE}, then {@code UNKNOWN} after a timeout.
+     */
+    synchronized Result onDataUnavailable(long nowMs) {
+        List<Transition> transitions = new ArrayList<>();
+        long ageMs = mLastValidSampleMs < 0 ? Long.MAX_VALUE
+                : Math.max(0, nowMs - mLastValidSampleMs);
+        int target = mLastValidSampleMs < 0 || ageMs >= UNKNOWN_AFTER_MS
+                ? DeviceHealthSnapshot.SEVERITY_UNKNOWN
+                : DeviceHealthSnapshot.SEVERITY_STALE;
+        String detail = mLastValidSampleMs < 0
+                ? "no samples received"
+                : "no fresh sample for " + ageMs / 1000 + "s";
+
+        for (Map.Entry<String, MetricState> entry : mStates.entrySet()) {
+            applyImmediate(entry.getValue(), entry.getKey(), target, 0.0f, 0.0f, detail, nowMs,
+                    transitions);
+        }
+        return new Result(target, transitions);
+    }
+
+    private void evaluateSample(MetricState state, DeviceHealthMetric metric, Thresholds thresholds,
+            long nowMs, List<Transition> transitions) {
+        int from = state.severity;
+        if (from == DeviceHealthSnapshot.SEVERITY_UNKNOWN
+                || from == DeviceHealthSnapshot.SEVERITY_STALE) {
+            // First sample or recovery: transition immediately to the observed severity.
+            int target = recoverState(metric.getValue(), thresholds);
+            applyImmediate(state, metric.getId(), target, metric.getValue(),
+                    thresholdForTransition(from, target, thresholds),
+                    formatSample(metric, from, target, thresholds), nowMs, transitions);
+            return;
+        }
+
+        int target = desiredState(from, metric.getValue(), thresholds);
+        if (target == from) {
+            state.pendingSeverity = target;
+            state.pendingCount = 0;
+            return;
+        }
+
+        if (state.pendingSeverity == target) {
+            state.pendingCount++;
+        } else {
+            state.pendingSeverity = target;
+            state.pendingCount = 1;
+        }
+        if (state.pendingCount >= thresholds.debounceSamples) {
+            applyImmediate(state, metric.getId(), target, metric.getValue(),
+                    thresholdForTransition(from, target, thresholds),
+                    formatSample(metric, from, target, thresholds), nowMs, transitions);
+        }
+    }
+
+    /**
+     * One step at a time, matching the designed state machine: NORMAL to WARNING
+     * to CRITICAL, and the reverse on the way down.
+     */
+    private static int desiredState(int current, float value, Thresholds thresholds) {
+        switch (current) {
+            case DeviceHealthSnapshot.SEVERITY_CRITICAL:
+                return value >= thresholds.criticalClear
+                        ? DeviceHealthSnapshot.SEVERITY_CRITICAL
+                        : DeviceHealthSnapshot.SEVERITY_WARNING;
+            case DeviceHealthSnapshot.SEVERITY_WARNING:
+                if (value >= thresholds.criticalEnter) {
+                    return DeviceHealthSnapshot.SEVERITY_CRITICAL;
+                }
+                return value >= thresholds.warningClear
+                        ? DeviceHealthSnapshot.SEVERITY_WARNING
+                        : DeviceHealthSnapshot.SEVERITY_NORMAL;
+            default:
+                return value >= thresholds.warningEnter
+                        ? DeviceHealthSnapshot.SEVERITY_WARNING
+                        : DeviceHealthSnapshot.SEVERITY_NORMAL;
+        }
+    }
+
+    private static int recoverState(float value, Thresholds thresholds) {
+        if (value >= thresholds.criticalEnter) {
+            return DeviceHealthSnapshot.SEVERITY_CRITICAL;
+        }
+        if (value >= thresholds.warningEnter) {
+            return DeviceHealthSnapshot.SEVERITY_WARNING;
+        }
+        return DeviceHealthSnapshot.SEVERITY_NORMAL;
+    }
+
+    private static float thresholdForTransition(int from, int to, Thresholds thresholds) {
+        switch (to) {
+            case DeviceHealthSnapshot.SEVERITY_CRITICAL:
+                return thresholds.criticalEnter;
+            case DeviceHealthSnapshot.SEVERITY_WARNING:
+                return from == DeviceHealthSnapshot.SEVERITY_CRITICAL
+                        ? thresholds.criticalClear : thresholds.warningEnter;
+            case DeviceHealthSnapshot.SEVERITY_NORMAL:
+                return thresholds.warningClear;
+            default:
+                return 0.0f;
+        }
+    }
+
+    private void applyImmediate(MetricState state, String metricId, int toSeverity, float value,
+            float threshold, String detail, long nowMs, List<Transition> transitions) {
+        int from = state.severity;
+        if (from == toSeverity) {
+            return;
+        }
+        state.severity = toSeverity;
+        state.pendingSeverity = toSeverity;
+        state.pendingCount = 0;
+
+        // The first normal sample after boot is not interesting enough for the history.
+        if (from == DeviceHealthSnapshot.SEVERITY_UNKNOWN
+                && toSeverity == DeviceHealthSnapshot.SEVERITY_NORMAL) {
+            return;
+        }
+        if (state.lastEventMs != 0
+                && nowMs - state.lastEventMs < MIN_EVENT_INTERVAL_MS) {
+            return;
+        }
+        state.lastEventMs = nowMs;
+        String message = String.format(Locale.US, "%s: %s -> %s (%s)", metricId,
+                severityName(from), severityName(toSeverity), detail);
+        transitions.add(new Transition(metricId, from, toSeverity, value, threshold, message));
+    }
+
+    synchronized void reset() {
+        mStates.clear();
+        mLastValidSampleMs = -1;
+    }
+
+    /**
+     * Maps a concrete metric ID to the threshold group that governs it, or {@code null}
+     * when the metric has no configured thresholds.
+     */
+    synchronized String thresholdKeyFor(String metricId) {
+        if (metricId == null) {
+            return null;
+        }
+        if (metricId.startsWith("thermal.")) {
+            return mThresholds.containsKey("thermal.") ? "thermal." : null;
+        }
+        return mThresholds.containsKey(metricId) ? metricId : null;
+    }
+
+    synchronized Thresholds thresholdsFor(String metricId) {
+        String key = thresholdKeyFor(metricId);
+        return key == null ? null : mThresholds.get(key);
+    }
+
+    private static String formatSample(DeviceHealthMetric metric, int from, int to,
+            Thresholds thresholds) {
+        float threshold = thresholdForTransition(from, to, thresholds);
+        return String.format(Locale.US, "%.1f %s, threshold %.1f", metric.getValue(),
+                metric.getUnit(), threshold);
+    }
+
+    static String severityName(int severity) {
+        switch (severity) {
+            case DeviceHealthSnapshot.SEVERITY_NORMAL:
+                return "NORMAL";
+            case DeviceHealthSnapshot.SEVERITY_WARNING:
+                return "WARNING";
+            case DeviceHealthSnapshot.SEVERITY_CRITICAL:
+                return "CRITICAL";
+            case DeviceHealthSnapshot.SEVERITY_STALE:
+                return "STALE";
+            default:
+                return "UNKNOWN";
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/devicehealth/PolicyEngineSelfTest.java b/services/core/java/com/android/server/devicehealth/PolicyEngineSelfTest.java
new file mode 100644
index 00000000..bfb91e08
--- /dev/null
+++ b/services/core/java/com/android/server/devicehealth/PolicyEngineSelfTest.java
@@ -0,0 +1,178 @@
+/*
