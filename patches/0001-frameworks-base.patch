+    private static final long DAEMON_CALL_TIMEOUT_MS = 1_500;
+    private static final long WATCHDOG_INTERVAL_MS = 5_000;
+    private static final long WATCHDOG_STALL_MS = 15_000;
+    private static final long WATCHDOG_RECOVERY_COOLDOWN_MS = 30_000;
+    private static final int MIN_DAEMON_VERSION = 1;
+    private static final int MAX_DAEMON_VERSION = 2;
+    private static final int KNOWN_DAEMON_CAPABILITIES = 0x3;
+    private static final float THERMAL_MIN_C = -40.0f;
+    private static final float THERMAL_MAX_C = 150.0f;
+    private static final float MEMORY_MIN_PERCENT = 0.0f;
+    private static final float MEMORY_MAX_PERCENT = 100.0f;
+
+    private final Object mLock = new Object();
+    private final PolicyEngine mPolicyEngine = new PolicyEngine();
+    private final ArrayDeque<DeviceHealthEvent> mEvents = new ArrayDeque<>();
+    private final Map<String, Float> mSimulatedValues = new HashMap<>();
+    private final RemoteCallbackList<IDeviceHealthListener> mListeners =
+            new RemoteCallbackList<>();
+    private final Map<String, CallStats> mCallStats = new ConcurrentHashMap<>();
+    private final ExecutorService mDaemonExecutor = Executors.newCachedThreadPool(r -> {
+        Thread thread = new Thread(r, "DeviceHealthDaemon");
+        thread.setDaemon(true);
+        return thread;
+    });
+    private final ScheduledExecutorService mWatchdogExecutor =
+            Executors.newSingleThreadScheduledExecutor(r -> {
+                Thread thread = new Thread(r, "DeviceHealthWatchdog");
+                thread.setDaemon(true);
+                return thread;
+            });
+    private final AtomicInteger mDaemonTimeouts = new AtomicInteger();
+    private final AtomicInteger mWatchdogTrips = new AtomicInteger();
+    private final AtomicInteger mWatchdogRecoveries = new AtomicInteger();
+    private final AtomicInteger mEvaluationGeneration = new AtomicInteger();
+
+    private volatile long mLastEvaluationEndMs;
+    private volatile long mLastEvaluationDurationMs;
+    private volatile long mLastWatchdogRecoveryMs;
+    private volatile int mDaemonVersionOverride = -1;
+    private volatile boolean mEvaluationStallReported;
+    private volatile String mLastRejectedSample = "";
+    private long mLastRejectedLogMs;
+
+    private IDeviceHealthService mDaemon;
+    private IBinder.DeathRecipient mDaemonDeathRecipient;
+    private NotificationManager mNotificationManager;
+    private boolean mChannelCreated;
+    private int mNextEventId = 1;
+
+    private volatile HandlerThread mHandlerThread;
+    private volatile Handler mHandler;
+    private boolean mEvaluationStarted;
+
+    private DeviceHealthSnapshot mLastSnapshot;
+    private List<DeviceHealthMetric> mLastMetrics = Collections.emptyList();
+    private long mLastSnapshotTimestampMs;
+    private int mEvaluationCount;
+    private int mLastUnknownCapabilities;
+
+    /**
+     * One instance drives a single evaluation loop. The generation check prevents an old
+     * loop from rescheduling itself after the watchdog replaced its handler thread.
+     */
+    private final class EvaluationRunnable implements Runnable {
+        private final int mGeneration;
+
+        EvaluationRunnable(int generation) {
+            mGeneration = generation;
+        }
+
+        @Override
+        public void run() {
+            if (mGeneration != mEvaluationGeneration.get()) {
+                return;
+            }
+            refresh();
+            Handler handler = mHandler;
+            if (handler != null && mGeneration == mEvaluationGeneration.get()) {
+                handler.postDelayed(this, EVALUATION_INTERVAL_MS);
+            }
+        }
+    }
+
+    public DeviceHealthManagerService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(Context.DEVICE_HEALTH_SERVICE, new BinderService());
+        mHandlerThread = new HandlerThread("DeviceHealth");
+        mHandlerThread.start();
+        mHandler = new Handler(mHandlerThread.getLooper());
+        Slog.i(TAG, "DeviceHealthManagerService started");
+    }
+
+    @Override
+    public void onBootPhase(int phase) {
+        if (phase == PHASE_SYSTEM_SERVICES_READY) {
+            ensureNotificationChannel();
+            startEvaluationLoop();
+        }
+    }
+
+    private void startEvaluationLoop() {
+        if (mEvaluationStarted || mHandler == null) {
+            return;
+        }
+        mEvaluationStarted = true;
+        final int generation = mEvaluationGeneration.incrementAndGet();
+        mHandler.post(new EvaluationRunnable(generation));
+        mWatchdogExecutor.scheduleWithFixedDelay(this::checkWatchdog, WATCHDOG_INTERVAL_MS,
+                WATCHDOG_INTERVAL_MS, TimeUnit.MILLISECONDS);
+        Slog.i(TAG, "Device health evaluation loop started (daemon versions "
+                + MIN_DAEMON_VERSION + ".." + MAX_DAEMON_VERSION + " supported)");
+    }
+
+    /**
+     * Replaces the evaluation handler thread. The old thread is asked to quit, and its loop
+     * cannot reschedule itself because the generation has changed.
+     */
+    private void restartEvaluationLoop(String reason) {
+        HandlerThread oldThread = mHandlerThread;
+        HandlerThread newThread = new HandlerThread("DeviceHealth");
+        newThread.start();
+        Handler newHandler = new Handler(newThread.getLooper());
+        final int generation = mEvaluationGeneration.incrementAndGet();
+        mHandlerThread = newThread;
+        mHandler = newHandler;
+        mLastEvaluationEndMs = SystemClock.elapsedRealtime();
+        // Let the next watchdog pass log the recovery once the new loop makes progress.
+        mEvaluationStallReported = true;
+        mWatchdogRecoveries.incrementAndGet();
+        newHandler.post(new EvaluationRunnable(generation));
+        if (oldThread != null) {
+            oldThread.quitSafely();
+        }
+        Slog.w(TAG, "Watchdog: restarted evaluation loop (" + reason + ")");
+    }
+
+    /**
+     * Runs on the watchdog thread. A stalled evaluation loop is restarted on a fresh
+     * HandlerThread, with a cooldown so a persistent deadlock cannot cause thread churn.
+     */
+    private void checkWatchdog() {
+        if (!mEvaluationStarted) {
+            return;
+        }
+        long lastEvaluationMs = mLastEvaluationEndMs;
+        if (lastEvaluationMs <= 0) {
+            return;
+        }
+        long ageMs = SystemClock.elapsedRealtime() - lastEvaluationMs;
+        if (ageMs > WATCHDOG_STALL_MS) {
+            if (!mEvaluationStallReported) {
+                mEvaluationStallReported = true;
+                mWatchdogTrips.incrementAndGet();
+                Slog.e(TAG, "Watchdog: evaluation loop stalled for " + ageMs + "ms");
+                long now = SystemClock.elapsedRealtime();
+                if (mLastWatchdogRecoveryMs == 0
+                        || now - mLastWatchdogRecoveryMs >= WATCHDOG_RECOVERY_COOLDOWN_MS) {
+                    mLastWatchdogRecoveryMs = now;
+                    restartEvaluationLoop("stalled " + ageMs + "ms");
+                } else {
+                    Slog.w(TAG, "Watchdog: recovery skipped, cooldown active");
+                }
+            }
+        } else if (mEvaluationStallReported) {
+            mEvaluationStallReported = false;
+            Slog.i(TAG, "Watchdog: evaluation loop recovered");
+        }
+    }
+
+    private void ensureNotificationChannel() {
+        if (mChannelCreated) {
+            return;
+        }
+        if (mNotificationManager == null) {
+            mNotificationManager = getContext().getSystemService(NotificationManager.class);
+        }
+        if (mNotificationManager == null) {
+            return;
+        }
+        NotificationChannel channel = new NotificationChannel(CHANNEL_ID,
+                "Device health alerts", NotificationManager.IMPORTANCE_HIGH);
+        channel.setDescription("Critical device health alerts");
+        mNotificationManager.createNotificationChannel(channel);
+        mChannelCreated = true;
+    }
+
+    private IDeviceHealthService getDaemon() {
+        synchronized (mLock) {
+            if (mDaemon != null) {
+                return mDaemon;
+            }
+            IBinder binder = ServiceManager.getService(DAEMON_SERVICE);
+            if (binder == null) {
+                return null;
+            }
+            mDaemon = IDeviceHealthService.Stub.asInterface(binder);
+            mDaemonDeathRecipient = () -> {
+                synchronized (mLock) {
+                    mDaemon = null;
+                    mDaemonDeathRecipient = null;
+                }
+                Slog.w(TAG, "devicehealthd died");
+                if (mHandler != null) {
+                    mHandler.post(DeviceHealthManagerService.this::refresh);
+                }
+            };
+            try {
+                binder.linkToDeath(mDaemonDeathRecipient, 0);
+            } catch (RemoteException e) {
+                mDaemon = null;
+                mDaemonDeathRecipient = null;
+                Slog.w(TAG, "Unable to link to devicehealthd", e);
+            }
+            return mDaemon;
+        }
+    }
+
+    /** Drops the daemon connection. Caller must hold {@link #mLock}. */
+    private void dropDaemonLocked() {
+        if (mDaemon != null && mDaemonDeathRecipient != null) {
+            try {
+                mDaemon.asBinder().unlinkToDeath(mDaemonDeathRecipient, 0);
+            } catch (NoSuchElementException e) {
+                // The binder already died; nothing left to unlink.
+            }
+        }
+        mDaemon = null;
+        mDaemonDeathRecipient = null;
+    }
+
+    private CallStats stats(String name) {
+        return mCallStats.computeIfAbsent(name, key -> new CallStats());
+    }
+
+    private static int compatibilityOf(int version) {
+        if (version < MIN_DAEMON_VERSION) {
+            return DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD;
+        }
+        if (version > MAX_DAEMON_VERSION) {
+            return DeviceHealthDaemonInfo.COMPATIBILITY_NEWER;
+        }
+        return DeviceHealthDaemonInfo.COMPATIBILITY_OK;
+    }
+
+    private static String compatibilityName(int compatibility) {
+        switch (compatibility) {
+            case DeviceHealthDaemonInfo.COMPATIBILITY_OK:
+                return "OK";
+            case DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD:
+                return "TOO_OLD";
+            case DeviceHealthDaemonInfo.COMPATIBILITY_NEWER:
+                return "NEWER";
+            default:
+                return "UNAVAILABLE";
+        }
+    }
+
+    private int effectiveDaemonVersion(int reportedVersion) {
+        int override = mDaemonVersionOverride;
+        return override >= 0 ? override : reportedVersion;
+    }
+
+    /** Bounds the daemon binder call so a wedged devicehealthd cannot stall evaluation. */
+    private SnapshotResult fetchSnapshot(IDeviceHealthService daemon) {
+        CallStats callStats = stats("daemon.getSnapshot");
+        long startMs = SystemClock.uptimeMillis();
+        Future<Snapshot> future = mDaemonExecutor.submit(() -> {
+            Trace.traceBegin(Trace.TRACE_TAG_SYSTEM_SERVER, "devicehealth.binder");
+            try {
+                return daemon.getSnapshot();
+            } finally {
+                Trace.traceEnd(Trace.TRACE_TAG_SYSTEM_SERVER);
+            }
+        });
+        try {
+            Snapshot snapshot = future.get(DAEMON_CALL_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            return new SnapshotResult(snapshot, null);
+        } catch (TimeoutException e) {
+            future.cancel(true);
+            mDaemonTimeouts.incrementAndGet();
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            Slog.w(TAG, "devicehealthd getSnapshot timed out after "
+                    + DAEMON_CALL_TIMEOUT_MS + "ms");
+            return new SnapshotResult(null, "getSnapshot timed out");
+        } catch (ExecutionException e) {
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            String message = describeFailure("getSnapshot", e.getCause());
+            Slog.w(TAG, message, e.getCause());
+            return new SnapshotResult(null, message);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return new SnapshotResult(null, "getSnapshot interrupted");
+        }
+    }
+
+    private DaemonInfoResult fetchDaemonInfo(IDeviceHealthService daemon) {
+        CallStats callStats = stats("daemon.getDaemonInfo");
+        long startMs = SystemClock.uptimeMillis();
+        Future<DaemonInfo> future = mDaemonExecutor.submit(daemon::getDaemonInfo);
+        try {
+            DaemonInfo info = future.get(DAEMON_CALL_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            return new DaemonInfoResult(info, null);
+        } catch (TimeoutException e) {
+            future.cancel(true);
+            mDaemonTimeouts.incrementAndGet();
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            Slog.w(TAG, "devicehealthd getDaemonInfo timed out after "
+                    + DAEMON_CALL_TIMEOUT_MS + "ms");
+            return new DaemonInfoResult(null, "getDaemonInfo timed out");
+        } catch (ExecutionException e) {
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            String message = describeFailure("getDaemonInfo", e.getCause());
+            Slog.w(TAG, message, e.getCause());
+            return new DaemonInfoResult(null, message);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return new DaemonInfoResult(null, "getDaemonInfo interrupted");
+        }
+    }
+
+    /** Returns the applied interval, or {@code -1} when the daemon cannot be reached. */
+    private int setDaemonSamplingInterval(int intervalMs) {
+        IDeviceHealthService daemon = getDaemon();
+        if (daemon == null) {
+            return -1;
+        }
+        CallStats callStats = stats("daemon.setSamplingIntervalMs");
+        long startMs = SystemClock.uptimeMillis();
+        Future<Integer> future = mDaemonExecutor.submit(
+                () -> daemon.setSamplingIntervalMs(intervalMs));
+        try {
+            int applied = future.get(DAEMON_CALL_TIMEOUT_MS, TimeUnit.MILLISECONDS);
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            return applied;
+        } catch (TimeoutException e) {
+            future.cancel(true);
+            mDaemonTimeouts.incrementAndGet();
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            Slog.w(TAG, "devicehealthd setSamplingIntervalMs timed out after "
+                    + DAEMON_CALL_TIMEOUT_MS + "ms");
+            return -1;
+        } catch (ExecutionException e) {
+            callStats.recordError();
+            callStats.record(SystemClock.uptimeMillis() - startMs);
+            Slog.w(TAG, describeFailure("setSamplingIntervalMs", e.getCause()), e.getCause());
+            return -1;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return -1;
+        }
+    }
+
+    private static String describeFailure(String operation, Throwable cause) {
+        if (cause == null) {
+            return operation + " failed";
+        }
+        String detail = cause.getMessage();
+        return operation + " failed: " + (detail == null ? cause.getClass().getSimpleName()
+                : detail);
+    }
+
+    private static final class SnapshotResult {
+        final Snapshot snapshot;
+        final String error;
+
+        SnapshotResult(Snapshot snapshot, String error) {
+            this.snapshot = snapshot;
+            this.error = error;
+        }
+    }
+
+    private static final class DaemonInfoResult {
+        final DaemonInfo info;
+        final String error;
+
+        DaemonInfoResult(DaemonInfo info, String error) {
+            this.info = info;
+            this.error = error;
+        }
+    }
+
+    private static final class CallStats {
+        private long mCount;
+        private long mErrors;
+        private long mTotalMs;
+        private long mMaxMs;
+
+        synchronized void record(long durationMs) {
+            mCount++;
+            mTotalMs += Math.max(0, durationMs);
+            if (durationMs > mMaxMs) {
+                mMaxMs = durationMs;
+            }
+        }
+
+        synchronized void recordError() {
+            mErrors++;
+        }
+
+        synchronized String describe() {
+            long averageMs = mCount == 0 ? 0 : mTotalMs / mCount;
+            return mCount + " calls, avg " + averageMs + "ms, max " + mMaxMs
+                    + "ms, errors " + mErrors;
+        }
+    }
+
+    /**
+     * Fetches one daemon snapshot, runs policy and publishes events. This is the
+     * only place where policy evaluation happens.
+     */
+    private void refresh() {
+        long refreshStartMs = SystemClock.elapsedRealtime();
+        IDeviceHealthService daemon = getDaemon();
+        Snapshot raw = null;
+        String daemonError = null;
+        if (daemon != null) {
+            SnapshotResult fetchResult = fetchSnapshot(daemon);
+            raw = fetchResult.snapshot;
+            daemonError = fetchResult.error;
+        }
+
+        List<DeviceHealthEvent> newEvents = new ArrayList<>();
+        List<DeviceHealthEvent> criticalEvents = new ArrayList<>();
+        DeviceHealthSnapshot snapshot;
+        synchronized (mLock) {
+            long now = SystemClock.elapsedRealtime();
+            int daemonVersion = 0;
+            int capabilities = 0;
+            long snapshotTimestamp;
+            boolean stale;
+            List<DeviceHealthMetric> metrics;
+            PolicyEngine.Result result;
+
+            if (raw == null) {
+                dropDaemonLocked();
+                if (daemonError != null) {
+                    Slog.w(TAG, "Unable to read devicehealthd snapshot: " + daemonError);
+                }
+                metrics = mLastMetrics;
+                result = mPolicyEngine.onDataUnavailable(now);
+                snapshotTimestamp = mLastSnapshotTimestampMs > 0 ? mLastSnapshotTimestampMs : now;
+                stale = true;
+            } else {
+                metrics = convertMetrics(raw.metrics, now);
+                Trace.traceBegin(Trace.TRACE_TAG_SYSTEM_SERVER, "devicehealth.policy");
+                try {
+                    result = mPolicyEngine.evaluate(metrics, now);
+                } finally {
+                    Trace.traceEnd(Trace.TRACE_TAG_SYSTEM_SERVER);
+                }
+                snapshotTimestamp = raw.timestampMs > 0 ? raw.timestampMs : now;
+                stale = raw.stale
+                        || result.overallSeverity == DeviceHealthSnapshot.SEVERITY_STALE
+                        || result.overallSeverity == DeviceHealthSnapshot.SEVERITY_UNKNOWN;
+                daemonVersion = raw.daemonVersion;
+                capabilities = raw.capabilities;
+                noteUnknownCapabilitiesLocked(capabilities);
+                mLastMetrics = metrics;
+                mLastSnapshotTimestampMs = snapshotTimestamp;
+            }
+
+            int compatibility = compatibilityOf(effectiveDaemonVersion(daemonVersion));
+            boolean degraded = raw != null
+                    && compatibility == DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD;
+            mEvaluationCount++;
+            if (!degraded) {
+                for (PolicyEngine.Transition transition : result.transitions) {
+                    DeviceHealthEvent event = new DeviceHealthEvent(mNextEventId++,
+                            transition.metricId, transition.fromSeverity, transition.toSeverity,
+                            transition.value, transition.threshold, now, transition.message);
+                    mEvents.addFirst(event);
+                    while (mEvents.size() > MAX_EVENTS) {
+                        mEvents.removeLast();
+                    }
+                    newEvents.add(event);
+                    if (transition.toSeverity == DeviceHealthSnapshot.SEVERITY_CRITICAL
+                            && transition.fromSeverity != DeviceHealthSnapshot.SEVERITY_CRITICAL) {
+                        criticalEvents.add(event);
+                    }
+                }
+            }
+
+            snapshot = new DeviceHealthSnapshot(metrics, result.overallSeverity,
+                    snapshotTimestamp, stale, daemonVersion, capabilities);
+            mLastSnapshot = snapshot;
+        }
+        mLastEvaluationEndMs = SystemClock.elapsedRealtime();
+        mLastEvaluationDurationMs = mLastEvaluationEndMs - refreshStartMs;
+
+        if (mListeners.getRegisteredCallbackCount() > 0) {
+            broadcastSnapshot(snapshot);
+            for (DeviceHealthEvent event : newEvents) {
+                broadcastEvent(event);
+            }
+        }
+        for (DeviceHealthEvent event : criticalEvents) {
+            postCriticalNotification(event);
+        }
+    }
+
+    private void noteUnknownCapabilitiesLocked(int capabilities) {
+        int unknown = capabilities & ~KNOWN_DAEMON_CAPABILITIES;
+        if (unknown != 0 && unknown != mLastUnknownCapabilities) {
+            mLastUnknownCapabilities = unknown;
+            Slog.w(TAG, "devicehealthd reports unknown capabilities 0x"
+                    + Integer.toHexString(unknown));
+        }
+    }
+
+    private void broadcastSnapshot(DeviceHealthSnapshot snapshot) {
+        int count = mListeners.beginBroadcast();
+        try {
+            for (int i = 0; i < count; i++) {
+                try {
+                    mListeners.getBroadcastItem(i).onSnapshotChanged(snapshot);
+                } catch (RemoteException | RuntimeException e) {
+                    // RemoteCallbackList removes dead listeners; ignore individual failures.
+                }
+            }
+        } finally {
+            mListeners.finishBroadcast();
+        }
+    }
+
+    private void broadcastEvent(DeviceHealthEvent event) {
+        int count = mListeners.beginBroadcast();
+        try {
+            for (int i = 0; i < count; i++) {
+                try {
+                    mListeners.getBroadcastItem(i).onEvent(event);
+                } catch (RemoteException | RuntimeException e) {
+                    // Ignore individual listener failures.
+                }
+            }
+        } finally {
+            mListeners.finishBroadcast();
+        }
+    }
