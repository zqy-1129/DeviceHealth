+ * delegated to devicehealthd. A background loop evaluates the latest daemon
+ * snapshot every few seconds, so events and critical notifications are produced
+ * even when no app is polling the service.
+ */
+public final class DeviceHealthManagerService extends SystemService {
+    private static final String TAG = "DeviceHealthService";
