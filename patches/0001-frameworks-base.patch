+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.devicehealth;
+
+import android.devicehealth.DeviceHealthMetric;
+import android.devicehealth.DeviceHealthSnapshot;
+
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Deterministic policy checks that run inside the service.
+ *
+ * <p>These cover debounce, hysteresis, escalation, staleness and validation without
+ * requiring a device test harness. Run them with {@code cmd devicehealth test-policy}.
+ */
+final class PolicyEngineSelfTest {
+    private static final long START_MS = 100_000;
+    private static final long SAMPLE_INTERVAL_MS = 1_000;
+
+    private final StringBuilder mReport = new StringBuilder();
+    private boolean mOk = true;
+
+    private PolicyEngineSelfTest() {
+    }
+
+    static String run() {
+        PolicyEngineSelfTest suite = new PolicyEngineSelfTest();
+        suite.testFirstSampleIsQuiet();
+        suite.testDebounceAndHysteresis();
+        suite.testCriticalEscalation();
+        suite.testStaleAndUnknown();
+        suite.testThresholdValidation();
+        suite.testEventRateLimit();
+        return suite.mReport.append(suite.mOk ? "POLICY TESTS PASS" : "POLICY TESTS FAIL")
+                .toString();
+    }
+
+    private void testFirstSampleIsQuiet() {
+        PolicyEngine engine = new PolicyEngine();
+        PolicyEngine.Result result = engine.evaluate(thermal(42.0f, START_MS), START_MS);
+        check("first normal sample produces no event", result.transitions.isEmpty());
+        check("first normal sample reports NORMAL",
+                result.overallSeverity == DeviceHealthSnapshot.SEVERITY_NORMAL);
+    }
+
+    private void testDebounceAndHysteresis() {
+        PolicyEngine engine = new PolicyEngine();
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        int transitions = 0;
+        for (int i = 1; i <= 2; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            transitions += engine.evaluate(thermal(66.0f, now), now).transitions.size();
+        }
+        check("debounce holds warning before 3 samples", transitions == 0);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result warning = engine.evaluate(thermal(66.0f, now), now);
+        check("warning after 3 samples", warning.transitions.size() == 1
+                && warning.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_WARNING);
+
+        transitions = 0;
+        for (int i = 1; i <= 2; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            transitions += engine.evaluate(thermal(58.0f, now), now).transitions.size();
+        }
+        check("debounce holds recovery before 3 samples", transitions == 0);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result recovered = engine.evaluate(thermal(58.0f, now), now);
+        check("hysteresis clears warning below warningClear", recovered.transitions.size() == 1
+                && recovered.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_NORMAL);
+    }
+
+    private void testCriticalEscalation() {
+        PolicyEngine engine = new PolicyEngine();
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        PolicyEngine.Result first = null;
+        for (int i = 0; i < 3; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            first = engine.evaluate(thermal(76.0f, now), now);
+        }
+        check("temperature escalates to WARNING first", first != null
+                && first.transitions.size() == 1
+                && first.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_WARNING);
+
+        PolicyEngine.Result second = null;
+        for (int i = 0; i < 3; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            second = engine.evaluate(thermal(76.0f, now), now);
+        }
+        check("temperature escalates WARNING to CRITICAL", second != null
+                && second.transitions.size() == 1
+                && second.transitions.get(0).fromSeverity
+                == DeviceHealthSnapshot.SEVERITY_WARNING
+                && second.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_CRITICAL);
+    }
+
+    private void testStaleAndUnknown() {
+        PolicyEngine engine = new PolicyEngine();
+        List<DeviceHealthMetric> metrics = thermal(42.0f, START_MS);
+        engine.evaluate(metrics, START_MS);
+
+        PolicyEngine.Result stale = engine.evaluate(metrics, START_MS + 11_000);
+        check("sample ages into STALE after 10s", stale.transitions.size() == 1
+                && stale.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_STALE);
+
+        PolicyEngine.Result unknown = engine.evaluate(metrics, START_MS + 31_000);
+        check("stale sample ages into UNKNOWN after 30s", unknown.transitions.size() == 1
+                && unknown.transitions.get(0).toSeverity
+                == DeviceHealthSnapshot.SEVERITY_UNKNOWN);
+    }
+
+    private void testThresholdValidation() {
+        check("valid thresholds accepted",
+                PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 3) == null);
+        check("inverted warning thresholds rejected",
+                PolicyEngine.validateThresholds(60.0f, 65.0f, 75.0f, 70.0f, 3) != null);
+        check("inverted critical thresholds rejected",
+                PolicyEngine.validateThresholds(65.0f, 60.0f, 70.0f, 75.0f, 3) != null);
+        check("critical below warning rejected",
+                PolicyEngine.validateThresholds(70.0f, 65.0f, 60.0f, 55.0f, 3) != null);
+        check("zero debounce rejected",
+                PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 0) != null);
+        check("debounce above 20 rejected",
+                PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 21) != null);
+    }
+
+    private void testEventRateLimit() {
+        PolicyEngine engine = new PolicyEngine();
+        engine.setThresholds("thermal.", new PolicyEngine.Thresholds(65.0f, 60.0f, 75.0f, 70.0f, 1));
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result warning = engine.evaluate(thermal(66.0f, now), now);
+        check("single-sample debounce produces warning", warning.transitions.size() == 1);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result suppressed = engine.evaluate(thermal(76.0f, now), now);
+        check("events within 2s are rate limited", suppressed.transitions.isEmpty());
+    }
+
+    private static List<DeviceHealthMetric> thermal(float value, long timestampMs) {
+        return Collections.singletonList(new DeviceHealthMetric("thermal.cpu", "CPU", value, "C",
+                timestampMs, /*simulated=*/false));
+    }
+
+    private void check(String name, boolean condition) {
+        if (!condition) {
+            mOk = false;
+        }
+        mReport.append(condition ? "PASS " : "FAIL ").append(name).append('\n');
+    }
+}
