+    private final class BinderService extends IDeviceHealthManager.Stub {
+        @Override
+        public DeviceHealthSnapshot getSnapshot() {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                return currentSnapshot();
+            } catch (RuntimeException e) {
+                stats("getSnapshot").recordError();
+                throw e;
+            } finally {
+                stats("getSnapshot").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public List<DeviceHealthEvent> getRecentEvents(int limit) {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                synchronized (mLock) {
+                    int max = limit <= 0 ? MAX_EVENTS : Math.min(limit, MAX_EVENTS);
+                    List<DeviceHealthEvent> result = new ArrayList<>();
+                    for (DeviceHealthEvent event : mEvents) {
+                        if (result.size() >= max) {
+                            break;
+                        }
+                        result.add(event);
+                    }
+                    return result;
+                }
+            } catch (RuntimeException e) {
+                stats("getRecentEvents").recordError();
+                throw e;
+            } finally {
+                stats("getRecentEvents").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public DeviceHealthDaemonInfo getDaemonInfo() {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                return queryDaemonInfo();
+            } catch (RuntimeException e) {
+                stats("getDaemonInfo").recordError();
+                throw e;
+            } finally {
+                stats("getDaemonInfo").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public void registerListener(IDeviceHealthListener listener) {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                if (listener == null) {
+                    throw new IllegalArgumentException("listener must not be null");
+                }
+                mListeners.register(listener);
+                DeviceHealthSnapshot snapshot = currentSnapshot();
+                try {
+                    listener.onSnapshotChanged(snapshot);
+                } catch (RemoteException | RuntimeException e) {
+                    // The listener died immediately; RemoteCallbackList will clean it up.
+                }
+                Slog.i(TAG, "Listener registered ("
+                        + mListeners.getRegisteredCallbackCount() + " active)");
+            } catch (RuntimeException e) {
+                stats("registerListener").recordError();
+                throw e;
+            } finally {
+                stats("registerListener").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public void unregisterListener(IDeviceHealthListener listener) {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                if (listener != null) {
+                    mListeners.unregister(listener);
+                }
+                Slog.i(TAG, "Listener unregistered ("
+                        + mListeners.getRegisteredCallbackCount() + " active)");
+            } catch (RuntimeException e) {
+                stats("unregisterListener").recordError();
+                throw e;
+            } finally {
+                stats("unregisterListener").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public void simulateCritical(String metricId) {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                enforceDebuggable();
+                ensureNotDegraded();
+                if (metricId == null) {
+                    throw new IllegalArgumentException("metricId must not be null");
+                }
+                armCriticalSimulation(metricId);
+            } catch (RuntimeException e) {
+                stats("simulateCritical").recordError();
+                throw e;
+            } finally {
+                stats("simulateCritical").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public void clearSimulated() {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                enforceDebuggable();
+                clearSimulatedMetrics();
+            } catch (RuntimeException e) {
+                stats("clearSimulated").recordError();
+                throw e;
+            } finally {
+                stats("clearSimulated").record(SystemClock.uptimeMillis() - startMs);
+            }
+        }
+
+        @Override
+        public void clearEvents() {
+            long startMs = SystemClock.uptimeMillis();
+            try {
+                enforcePermission();
+                clearEventsInternal();
+            } catch (RuntimeException e) {
+                stats("clearEvents").recordError();
+                throw e;
+            } finally {
