new file mode 100644
index 00000000..36f0ca6b
--- /dev/null
+++ b/core/java/android/devicehealth/DeviceHealthManager.java
@@ -0,0 +1,234 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.devicehealth;
+
+import android.Manifest;
+import android.annotation.NonNull;
+import android.annotation.RequiresPermission;
+import android.annotation.SuppressLint;
+import android.annotation.SystemApi;
+import android.os.RemoteException;
+
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.Executor;
+
+/**
+ * Provides access to device health snapshots and recent health events.
+ *
+ * @hide
+ */
+@SystemApi
+public final class DeviceHealthManager {
+    private final IDeviceHealthManager mService;
+    private final Object mListenerLock = new Object();
+    private final Map<DeviceHealthListener, ListenerTransport> mListeners =
+            new IdentityHashMap<>();
+
+    /** @hide */
+    public DeviceHealthManager(@NonNull IDeviceHealthManager service) {
+        mService = service;
+    }
+
+    /**
+     * Returns the latest device health snapshot.
+     *
+     * @hide
+     */
+    @SystemApi
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public @NonNull DeviceHealthSnapshot getSnapshot() {
+        try {
+            return mService.getSnapshot();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Returns up to {@code limit} recent health events, newest first.
+     *
+     * @hide
+     */
+    @SystemApi
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public @NonNull List<DeviceHealthEvent> getRecentEvents(int limit) {
+        try {
+            return mService.getRecentEvents(limit);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Returns diagnostic information about the native daemon.
+     *
+     * @hide
+     */
+    @SystemApi
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public @NonNull DeviceHealthDaemonInfo getDaemonInfo() {
+        try {
+            return mService.getDaemonInfo();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Registers a listener that receives snapshots and events as they are produced by the
+     * framework. Registering the same listener again replaces the previous executor.
+     *
+     * @hide
+     */
+    @SystemApi
+    @SuppressLint("UnflaggedApi")
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public void registerListener(@NonNull Executor executor, @NonNull DeviceHealthListener listener) {
+        if (executor == null) {
+            throw new NullPointerException("executor must not be null");
+        }
+        if (listener == null) {
+            throw new NullPointerException("listener must not be null");
+        }
+        ListenerTransport transport = new ListenerTransport(executor, listener);
+        ListenerTransport previous;
+        synchronized (mListenerLock) {
+            previous = mListeners.put(listener, transport);
+        }
+        if (previous != null) {
+            try {
+                mService.unregisterListener(previous);
+            } catch (RemoteException e) {
+                // The service is restarting; the old registration is gone with it.
+            }
+        }
+        try {
+            mService.registerListener(transport);
+        } catch (RemoteException e) {
+            synchronized (mListenerLock) {
+                mListeners.remove(listener);
+            }
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Unregisters a listener previously passed to
+     * {@link #registerListener(Executor, DeviceHealthListener)}. Unknown listeners are ignored.
+     *
+     * @hide
+     */
+    @SystemApi
+    @SuppressLint("UnflaggedApi")
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public void unregisterListener(@NonNull DeviceHealthListener listener) {
+        if (listener == null) {
+            return;
+        }
+        ListenerTransport transport;
+        synchronized (mListenerLock) {
+            transport = mListeners.remove(listener);
+        }
+        if (transport == null) {
+            return;
+        }
+        try {
+            mService.unregisterListener(transport);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Injects a critical value for the given metric so the policy engine can be
+     * exercised without special hardware. Only available on debuggable builds.
+     *
+     * @hide
+     */
+    @SystemApi
+    @SuppressLint("UnflaggedApi")
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public void simulateCritical(@NonNull String metricId) {
+        try {
+            mService.simulateCritical(metricId);
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Clears all simulated metric values.
+     *
+     * @hide
+     */
+    @SystemApi
+    @SuppressLint("UnflaggedApi")
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public void clearSimulated() {
+        try {
+            mService.clearSimulated();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    /**
+     * Clears the recent event history and cancels its notifications.
+     *
+     * @hide
+     */
+    @SystemApi
+    @SuppressLint("UnflaggedApi")
+    @RequiresPermission(Manifest.permission.MANAGE_DEVICE_HEALTH)
+    public void clearEvents() {
+        try {
+            mService.clearEvents();
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+    }
+
+    private static final class ListenerTransport extends IDeviceHealthListener.Stub {
+        private final Executor mExecutor;
+        private final DeviceHealthListener mListener;
+
+        ListenerTransport(Executor executor, DeviceHealthListener listener) {
+            mExecutor = executor;
+            mListener = listener;
+        }
+
+        @Override
+        public void onSnapshotChanged(DeviceHealthSnapshot snapshot) {
+            dispatch(() -> mListener.onSnapshotChanged(snapshot));
+        }
+
+        @Override
+        public void onEvent(DeviceHealthEvent event) {
+            dispatch(() -> mListener.onEvent(event));
+        }
+
+        private void dispatch(Runnable callback) {
+            try {
+                mExecutor.execute(callback);
+            } catch (RuntimeException e) {
+                // The listener's executor is gone (app died or shut down); drop the callback.
+            }
+        }
+    }
+}
