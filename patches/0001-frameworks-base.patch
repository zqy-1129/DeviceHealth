+            pw.println("  self-test");
+            pw.println("    Run basic service diagnostics.");
+            pw.println("  test-policy");
+            pw.println("    Run deterministic policy engine checks.");
+        }
+
+        private boolean checkShellPermission() {
+            int uid = Binder.getCallingUid();
+            if (uid == Process.ROOT_UID || uid == Process.SHELL_UID) {
+                return true;
+            }
+            try {
+                getContext().enforceCallingOrSelfPermission(
+                        Manifest.permission.MANAGE_DEVICE_HEALTH, TAG);
+                return true;
+            } catch (SecurityException e) {
+                return false;
+            }
+        }
+
+        private int runStatus() {
+            refresh();
+            PrintWriter pw = getOutPrintWriter();
+            synchronized (mLock) {
+                if (mLastSnapshot == null) {
+                    pw.println("Device health service is not initialized");
+                    return 1;
+                }
+                long now = SystemClock.elapsedRealtime();
+                pw.println("state: "
+                        + PolicyEngine.severityName(mLastSnapshot.getOverallSeverity()));
+                pw.println("stale: " + mLastSnapshot.isStale());
+                pw.println("last update: "
+                        + Math.max(0, now - mLastSnapshot.getTimestampMs()) + "ms ago");
+                pw.println("daemon: " + (mDaemon != null ? "connected" : "unavailable")
+                        + " version=" + mLastSnapshot.getDaemonVersion()
+                        + " capabilities=0x"
+                        + Integer.toHexString(mLastSnapshot.getCapabilities()));
+                if (mDaemonVersionOverride >= 0) {
+                    pw.println("daemon version override: " + mDaemonVersionOverride + " (debug)");
+                }
+                pw.println("listeners: " + mListeners.getRegisteredCallbackCount());
+                pw.println("watchdog: " + (mEvaluationStallReported ? "STALLED" : "ok")
+                        + " (trips " + mWatchdogTrips.get()
+                        + ", recoveries " + mWatchdogRecoveries.get()
+                        + ", daemon timeouts " + mDaemonTimeouts.get() + ")");
+                pw.println("last rejected sample: "
+                        + (mLastRejectedSample.isEmpty() ? "none" : mLastRejectedSample));
+                pw.println("events: " + mEvents.size());
+                if (!mSimulatedValues.isEmpty()) {
+                    pw.println("simulated: " + mSimulatedValues);
+                }
+                pw.println("metrics:");
+                for (DeviceHealthMetric metric : mLastSnapshot.getMetrics()) {
+                    pw.println("  " + metric.getId() + ": " + metric.getValue() + " "
+                            + metric.getUnit() + (metric.isSimulated() ? " (simulated)" : ""));
+                }
+            }
+            DeviceHealthDaemonInfo info = queryDaemonInfo();
+            pw.println("compatibility: " + compatibilityName(info.getCompatibility())
+                    + " (supported " + MIN_DAEMON_VERSION + ".." + MAX_DAEMON_VERSION + ")");
+            pw.println("last error: "
+                    + (info.getLastError().isEmpty() ? "none" : info.getLastError()));
+            return 0;
+        }
+
+        private int runHistory() {
+            int limit = 20;
+            String option;
+            while ((option = getNextOption()) != null) {
+                if ("--limit".equals(option) || "-l".equals(option)) {
+                    String value = getNextArg();
+                    if (value == null) {
+                        getErrPrintWriter().println("Missing value for " + option);
+                        return -1;
+                    }
+                    try {
+                        limit = Integer.parseInt(value);
+                    } catch (NumberFormatException e) {
+                        getErrPrintWriter().println("Invalid limit: " + value);
+                        return -1;
+                    }
+                } else {
+                    getErrPrintWriter().println("Unknown option: " + option);
+                    return -1;
+                }
+            }
+            if (limit <= 0) {
+                limit = 20;
+            }
+            limit = Math.min(limit, MAX_EVENTS);
+
+            List<DeviceHealthEvent> events = new ArrayList<>();
+            synchronized (mLock) {
+                for (DeviceHealthEvent event : mEvents) {
+                    if (events.size() >= limit) {
+                        break;
+                    }
+                    events.add(event);
+                }
+            }
+
+            PrintWriter pw = getOutPrintWriter();
+            if (events.isEmpty()) {
+                pw.println("No events");
+                return 0;
+            }
+            long now = SystemClock.elapsedRealtime();
+            for (DeviceHealthEvent event : events) {
+                pw.println("#" + event.getEventId() + " "
+                        + Math.max(0, now - event.getTimestampMs()) + "ms ago: "
+                        + event.getMessage());
+            }
+            return 0;
+        }
+
+        private int runThresholds() {
+            PrintWriter pw = getOutPrintWriter();
+            String action = getNextArg();
+            if (action == null) {
+                printThresholds(pw);
+                return 0;
+            }
+            if ("reset".equals(action)) {
+                mPolicyEngine.resetThresholds();
+                mPolicyEngine.reset();
+                refresh();
+                printThresholds(pw);
+                pw.println("Thresholds restored to defaults");
+                return 0;
+            }
+            if (!"set".equals(action)) {
+                getErrPrintWriter().println("Usage: cmd devicehealth thresholds [set <metricId>"
+                        + " <warnEnter> <warnClear> <critEnter> <critClear> <debounce> | reset]");
+                return -1;
+            }
+            String metricId = getNextArg();
+            if (metricId == null) {
+                getErrPrintWriter().println("Missing metric ID");
+                return -1;
+            }
+            String key = mPolicyEngine.thresholdKeyFor(metricId);
+            if (key == null) {
+                getErrPrintWriter().println("Unsupported metric: " + metricId);
+                getErrPrintWriter().println("Supported metrics: thermal.*, memory.pressure");
+                return -1;
+            }
+            float[] values = new float[4];
+            String[] names = {"warningEnter", "warningClear", "criticalEnter", "criticalClear"};
+            for (int i = 0; i < values.length; i++) {
+                String arg = getNextArg();
+                if (arg == null) {
+                    getErrPrintWriter().println("Missing " + names[i]);
+                    return -1;
+                }
+                try {
+                    values[i] = Float.parseFloat(arg);
+                } catch (NumberFormatException e) {
+                    getErrPrintWriter().println("Invalid " + names[i] + ": " + arg);
+                    return -1;
+                }
+            }
+            String debounceArg = getNextArg();
+            int debounceSamples;
+            try {
+                debounceSamples = Integer.parseInt(debounceArg);
+            } catch (NumberFormatException e) {
+                getErrPrintWriter().println("Missing or invalid debounce: " + debounceArg);
+                return -1;
+            }
+            String problem = PolicyEngine.validateThresholds(values[0], values[1], values[2],
+                    values[3], debounceSamples);
+            if (problem == null) {
+                problem = validateThresholdRange(key, values);
+            }
+            if (problem != null) {
+                getErrPrintWriter().println("Rejected: " + problem);
+                return -1;
+            }
+            if (isDaemonDegraded()) {
+                getErrPrintWriter().println(
+                        "Daemon interface is not supported; threshold changes are disabled");
+                return -1;
+            }
+            mPolicyEngine.setThresholds(key,
+                    new PolicyEngine.Thresholds(values[0], values[1], values[2], values[3],
+                            debounceSamples));
+            mPolicyEngine.reset();
+            refresh();
+            printThresholds(pw);
+            pw.println("Updated " + key + "; policy state reset for re-evaluation");
+            return 0;
+        }
+
+        private String validateThresholdRange(String key, float[] values) {
+            float min;
+            float max;
+            if ("thermal.".equals(key)) {
+                min = THERMAL_MIN_C;
+                max = THERMAL_MAX_C;
+            } else if ("memory.pressure".equals(key)) {
+                min = MEMORY_MIN_PERCENT;
+                max = MEMORY_MAX_PERCENT;
+            } else {
+                return null;
+            }
+            for (float value : values) {
+                if (value < min || value > max) {
+                    return "threshold " + value + " is outside " + key + " range ["
+                            + min + ", " + max + "]";
+                }
+            }
+            return null;
+        }
+
+        private void printThresholds(PrintWriter pw) {
+            for (Map.Entry<String, PolicyEngine.Thresholds> entry
+                    : mPolicyEngine.getThresholds().entrySet()) {
+                pw.println(entry.getKey() + ": " + entry.getValue().describe());
+            }
+        }
+
+        private int runSimulate() {
+            String kind = getNextArg();
+            if (kind == null) {
+                getErrPrintWriter().println(
+                        "Usage: cmd devicehealth simulate critical <metricId>|clear");
+                return -1;
+            }
+            if ("clear".equals(kind)) {
+                clearSimulatedMetrics();
+                getOutPrintWriter().println("Cleared simulated metric overrides");
+                return 0;
+            }
+            if (!"critical".equals(kind)) {
+                getErrPrintWriter().println("Unknown simulation: " + kind);
+                return -1;
+            }
+            String metricId = getNextArg();
+            if (metricId == null) {
+                getErrPrintWriter().println(
+                        "Usage: cmd devicehealth simulate critical <metricId>");
+                return -1;
+            }
+            PolicyEngine.Thresholds thresholds = mPolicyEngine.thresholdsFor(metricId);
+            if (thresholds == null) {
+                getErrPrintWriter().println("Unsupported metric: " + metricId);
+                getErrPrintWriter().println("Supported metrics: thermal.*, memory.pressure");
+                return -1;
+            }
+            if (isDaemonDegraded()) {
+                getErrPrintWriter().println(
+                        "Daemon interface is not supported; simulation is disabled");
+                return -1;
+            }
+            float value = thresholds.criticalEnter + 5.0f;
+            armCriticalSimulation(metricId);
+            getOutPrintWriter().println("Simulated " + metricId + " = " + value
+                    + "; CRITICAL is expected after " + (thresholds.debounceSamples * 2)
+                    + " samples (two state steps)");
+            return 0;
+        }
+
+        private int runStats() {
+            PrintWriter pw = getOutPrintWriter();
+            List<String> names = new ArrayList<>(mCallStats.keySet());
+            Collections.sort(names);
+            if (names.isEmpty()) {
+                pw.println("No calls recorded");
+                return 0;
+            }
+            for (String name : names) {
+                pw.println(name + ": " + mCallStats.get(name).describe());
+            }
+            return 0;
+        }
+
+        private int runDaemonInterval() {
+            String arg = getNextArg();
+            if (arg == null) {
+                getErrPrintWriter().println(
+                        "Usage: cmd devicehealth daemon-interval <ms|reset>");
+                return -1;
+            }
+            int requestedMs;
+            if ("reset".equals(arg)) {
+                requestedMs = 2000;
+            } else {
+                try {
+                    requestedMs = Integer.parseInt(arg);
+                } catch (NumberFormatException e) {
+                    getErrPrintWriter().println("Invalid interval: " + arg);
+                    return -1;
+                }
+                if (requestedMs < 500 || requestedMs > 30000) {
+                    getErrPrintWriter().println(
+                            "Interval must be between 500 and 30000 ms");
+                    return -1;
+                }
+            }
+
+            IDeviceHealthService daemon = getDaemon();
+            if (daemon == null) {
+                getErrPrintWriter().println("devicehealthd is not available");
+                return -1;
+            }
+            DaemonInfoResult info = fetchDaemonInfo(daemon);
+            int version = info.info != null
+                    ? effectiveDaemonVersion(info.info.interfaceVersion)
+                    : (mLastSnapshot != null ? mLastSnapshot.getDaemonVersion() : 0);
+            if (version < 2) {
+                getErrPrintWriter().println(
+                        "Requires daemon interface version 2, current is " + version);
+                return -1;
+            }
+            int appliedMs = setDaemonSamplingInterval(requestedMs);
+            if (appliedMs < 0) {
+                getErrPrintWriter().println("Failed to update the daemon sampling interval");
+                return -1;
+            }
+            getOutPrintWriter().println("Sampling interval set to " + appliedMs
+                    + "ms (requested " + requestedMs + "ms)");
+            return 0;
+        }
+
+        private int runDebug() {
+            String what = getNextArg();
+            if (what == null) {
+                getErrPrintWriter().println(
+                        "Usage: cmd devicehealth debug stall <ms>|hold-lock <ms>|"
+                                + "reset-watchdog|set-daemon-version <version|reset>");
+                return -1;
+            }
+            if ("stall".equals(what)) {
+                String arg = getNextArg();
+                int durationMs = 20_000;
+                if (arg != null) {
+                    try {
+                        durationMs = Integer.parseInt(arg);
+                    } catch (NumberFormatException e) {
+                        getErrPrintWriter().println("Invalid duration: " + arg);
+                        return -1;
+                    }
+                }
+                if (durationMs <= 0 || durationMs > 60_000) {
+                    getErrPrintWriter().println("Duration must be between 1 and 60000 ms");
+                    return -1;
+                }
+                final int stallMs = durationMs;
+                mHandler.post(() -> SystemClock.sleep(stallMs));
+                getOutPrintWriter().println("Blocking the evaluation thread for " + durationMs
+                        + "ms; watchdog trips after " + WATCHDOG_STALL_MS + "ms");
+                return 0;
+            }
+            if ("hold-lock".equals(what)) {
+                String arg = getNextArg();
+                int durationMs = 20_000;
+                if (arg != null) {
+                    try {
+                        durationMs = Integer.parseInt(arg);
+                    } catch (NumberFormatException e) {
+                        getErrPrintWriter().println("Invalid duration: " + arg);
+                        return -1;
+                    }
+                }
+                if (durationMs <= 0 || durationMs > 60_000) {
+                    getErrPrintWriter().println("Duration must be between 1 and 60000 ms");
+                    return -1;
+                }
+                final long holdMs = durationMs;
+                Thread holder = new Thread(() -> {
+                    synchronized (mLock) {
+                        Slog.w(TAG, "Debug: holding mLock for " + holdMs + "ms");
+                        SystemClock.sleep(holdMs);
+                    }
+                    Slog.w(TAG, "Debug: released mLock");
+                }, "DeviceHealth-debug-lock");
+                holder.start();
+                getOutPrintWriter().println("Holding mLock for " + durationMs + "ms");
+                return 0;
+            }
+            if ("reset-watchdog".equals(what)) {
+                mWatchdogTrips.set(0);
+                mWatchdogRecoveries.set(0);
+                mLastWatchdogRecoveryMs = 0;
+                mEvaluationStallReported = false;
+                getOutPrintWriter().println("Watchdog counters and cooldown reset");
+                return 0;
+            }
+            if ("set-daemon-version".equals(what)) {
+                String arg = getNextArg();
+                if (arg == null) {
+                    getErrPrintWriter().println(
+                            "Usage: cmd devicehealth debug set-daemon-version <version|reset>");
+                    return -1;
+                }
+                if ("reset".equals(arg)) {
+                    mDaemonVersionOverride = -1;
+                    getOutPrintWriter().println("Daemon version override cleared");
+                } else {
+                    int version;
+                    try {
+                        version = Integer.parseInt(arg);
+                    } catch (NumberFormatException e) {
+                        getErrPrintWriter().println("Invalid version: " + arg);
+                        return -1;
+                    }
+                    if (version < 0 || version > 1000) {
+                        getErrPrintWriter().println("Version must be between 0 and 1000");
+                        return -1;
+                    }
+                    mDaemonVersionOverride = version;
+                    getOutPrintWriter().println("Daemon version override set to " + version);
+                }
+                mPolicyEngine.reset();
+                refresh();
+                return 0;
+            }
+            getErrPrintWriter().println("Unknown debug command: " + what);
+            return -1;
+        }
+
+        private int runReset() {
+            List<Integer> notificationIds = new ArrayList<>();
+            synchronized (mLock) {
+                for (DeviceHealthEvent event : mEvents) {
+                    notificationIds.add(event.getEventId());
+                }
+                mEvents.clear();
+                mSimulatedValues.clear();
+                mPolicyEngine.reset();
+            }
+            refresh();
+            if (mNotificationManager != null && !notificationIds.isEmpty()) {
+                long token = Binder.clearCallingIdentity();
+                try {
+                    for (int id : notificationIds) {
+                        mNotificationManager.cancel(NOTIFICATION_TAG, id);
+                    }
+                } finally {
+                    Binder.restoreCallingIdentity(token);
+                }
+            }
+            getOutPrintWriter().println("Cleared events, simulated overrides and policy state");
+            return 0;
+        }
+
+        private int runPolicyTests() {
+            String report = PolicyEngineSelfTest.run();
+            getOutPrintWriter().println(report);
+            return report.endsWith("POLICY TESTS PASS") ? 0 : 1;
+        }
+
+        private int runSelfTest() {
+            PrintWriter pw = getOutPrintWriter();
+            boolean ok = true;
+
+            IDeviceHealthService daemon = getDaemon();
+            if (daemon == null) {
+                pw.println("FAIL daemon: devicehealthd is not registered");
+                ok = false;
+            } else {
+                SnapshotResult result = fetchSnapshot(daemon);
+                Snapshot snapshot = result.snapshot;
+                if (snapshot == null) {
+                    pw.println("FAIL daemon: "
+                            + (result.error == null ? "null snapshot" : result.error));
+                    ok = false;
+                } else {
+                    int version = effectiveDaemonVersion(snapshot.daemonVersion);
+                    int compatibility = compatibilityOf(version);
+                    if (compatibility == DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD) {
+                        pw.println("FAIL compatibility: daemon version " + version
+                                + " is below " + MIN_DAEMON_VERSION + " (degraded mode)");
+                        ok = false;
+                    } else if (compatibility == DeviceHealthDaemonInfo.COMPATIBILITY_NEWER) {
+                        pw.println("WARN compatibility: daemon version " + version
+                                + " is newer than " + MAX_DAEMON_VERSION
+                                + " (unknown capabilities ignored)");
+                    } else {
+                        pw.println("PASS compatibility: daemon version " + version
+                                + " in " + MIN_DAEMON_VERSION + ".." + MAX_DAEMON_VERSION);
+                    }
+                    pw.println("PASS daemon: version=" + snapshot.daemonVersion
+                            + " capabilities=0x"
+                            + Integer.toHexString(snapshot.capabilities));
+                    int count = snapshot.metrics == null ? 0 : snapshot.metrics.length;
+                    if (count == 0) {
+                        pw.println("FAIL metrics: no samples reported");
+                        ok = false;
+                    } else {
+                        pw.println("PASS metrics: " + count + " sample(s)");
+                        boolean simulated = false;
+                        for (MetricSample sample : snapshot.metrics) {
+                            if (sample.simulated) {
+                                simulated = true;
+                                break;
+                            }
+                        }
+                        if (simulated) {
+                            pw.println("WARN metrics: at least one sample is simulated");
+                        }
+                    }
+                }
+            }
+
+            ensureNotificationChannel();
+            if (mNotificationManager != null && mChannelCreated) {
+                pw.println("PASS notification channel: " + CHANNEL_ID);
+            } else {
+                pw.println("FAIL notification channel: " + CHANNEL_ID);
+                ok = false;
+            }
+
+            if (mPolicyEngine.getThresholds().isEmpty()) {
+                pw.println("FAIL policy: no thresholds configured");
+                ok = false;
+            } else {
+                pw.println("PASS policy: " + mPolicyEngine.getThresholds().size()
+                        + " threshold group(s)");
+            }
+
+            long evaluationAgeMs = mLastEvaluationEndMs <= 0 ? -1
+                    : SystemClock.elapsedRealtime() - mLastEvaluationEndMs;
+            if (mWatchdogTrips.get() > 0) {
+                pw.println("WARN watchdog: " + mWatchdogTrips.get()
+                        + " stall(s) detected, " + mWatchdogRecoveries.get()
+                        + " recovery restart(s), last evaluation " + evaluationAgeMs + "ms ago");
+            } else {
+                pw.println("PASS watchdog: last evaluation " + evaluationAgeMs + "ms ago");
+            }
+
+            if (mLastRejectedSample.isEmpty()) {
+                pw.println("PASS validation: all samples in range");
+            } else {
+                pw.println("WARN validation: last rejected sample " + mLastRejectedSample);
+            }
+            pw.println("INFO listeners: " + mListeners.getRegisteredCallbackCount() + " active");
+
+            synchronized (mLock) {
+                if (mEvents.size() > MAX_EVENTS) {
+                    pw.println("FAIL events: store exceeds " + MAX_EVENTS);
+                    ok = false;
+                } else {
+                    pw.println("PASS events: " + mEvents.size() + " buffered");
+                }
+            }
+
+            pw.println(ok ? "SELF-TEST PASS" : "SELF-TEST FAIL");
+            return ok ? 0 : 1;
+        }
+    }
+
+    private void enforcePermission() {
+        getContext().enforceCallingOrSelfPermission(Manifest.permission.MANAGE_DEVICE_HEALTH,
+                TAG);
+    }
+}
