diff --git dh-b/packages/apps/DeviceHealthCenter/tests/denial/src/com/android/devicehealthcenter/denialtest/DenialActivity.java dh-b/packages/apps/DeviceHealthCenter/tests/denial/src/com/android/devicehealthcenter/denialtest/DenialActivity.java
