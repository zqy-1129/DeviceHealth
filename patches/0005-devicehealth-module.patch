+    private void renderDiagnostics(DeviceHealthSnapshot snapshot, DeviceHealthDaemonInfo info,
+            List<DeviceHealthEvent> events) {
+        if (mHalStatusText == null) {
+            return;
+        }
+
+        int thermalCount = 0;
+        boolean allSimulated = true;
+        if (snapshot != null) {
+            for (DeviceHealthMetric metric : snapshot.getMetrics()) {
+                if (metric.getId().startsWith("thermal.")) {
+                    thermalCount++;
+                    if (!metric.isSimulated()) {
+                        allSimulated = false;
+                    }
+                }
+            }
+        }
+        if (thermalCount == 0) {
+            setStatus(mHalStatusText, "HAL：不可用（无 thermal 数据）", COLOR_CRITICAL);
+        } else if (allSimulated) {
+            setStatus(mHalStatusText, "HAL：模拟数据（未读取到 thermal 节点）", COLOR_WARNING);
+        } else {
+            setStatus(mHalStatusText, "HAL：正常（真实 thermal 数据）", COLOR_NORMAL);
+        }
+
+        if (info == null || info.getInterfaceVersion() <= 0) {
+            setStatus(mDaemonInfoText, "daemon：不可用", COLOR_CRITICAL);
+        } else if (info.getCompatibility() == DeviceHealthDaemonInfo.COMPATIBILITY_TOO_OLD) {
+            setStatus(mDaemonInfoText, "daemon：不兼容 · 接口版本低于最低支持 v1 · "
+                    + "降级模式（事件/设置已禁用）", COLOR_CRITICAL);
+        } else if (info.getCompatibility() == DeviceHealthDaemonInfo.COMPATIBILITY_NEWER) {
+            setStatus(mDaemonInfoText, "daemon：正常 · 接口 v" + info.getInterfaceVersion()
+                    + " 较新（未知能力已忽略）", COLOR_WARNING);
+        } else {
+            int color = info.getLastError().isEmpty() ? COLOR_NORMAL : COLOR_WARNING;
+            setStatus(mDaemonInfoText, "daemon：正常 · 接口 v" + info.getInterfaceVersion()
+                    + " · 能力 0x" + Integer.toHexString(info.getCapabilities())
+                    + " · PID " + info.getPid(), color);
+        }
+
+        if (snapshot == null) {
+            setStatus(mFrameworkStatusText, "framework：—", COLOR_MUTED);
+        } else if (snapshot.isStale()) {
+            setStatus(mFrameworkStatusText, "framework：缓存/降级", COLOR_WARNING);
+        } else if (snapshot.getOverallSeverity() == DeviceHealthSnapshot.SEVERITY_UNKNOWN) {
+            setStatus(mFrameworkStatusText, "framework：数据未知", COLOR_CRITICAL);
+        } else if (snapshot.getOverallSeverity() == DeviceHealthSnapshot.SEVERITY_STALE) {
+            setStatus(mFrameworkStatusText, "framework：数据过期", COLOR_WARNING);
+        } else {
+            setStatus(mFrameworkStatusText, "framework：正常", COLOR_NORMAL);
+        }
+
+        switch (mConnectionState) {
+            case CONNECTION_RECONNECTING:
+                setStatus(mAppStatusText, "App：重连中 · 已重试 " + mConsecutiveFailures
+                        + " 次 · " + mLastFailureMessage, COLOR_WARNING);
+                break;
+            case CONNECTION_ERROR:
+                setStatus(mAppStatusText, "App：不可用 · " + mLastFailureMessage, COLOR_CRITICAL);
+                break;
+            default:
+                setStatus(mAppStatusText, "App：正常 · "
+                        + (mListenerRegistered ? "推送监听" : "轮询")
+                        + " · 成功刷新 " + mRefreshSuccessCount + " 次", COLOR_NORMAL);
+                break;
+        }
+
+        String lastError = info != null ? info.getLastError() : "";
+        mLastErrorText.setText(lastError.isEmpty() ? "最后错误：无" : "最后错误：" + lastError);
+        mApexVersionText.setText("APEX 版本：" + (mApexVersion.isEmpty() ? "查询中…" : mApexVersion));
+
+        long ageSeconds = snapshot == null ? -1
+                : Math.max(0, (SystemClock.elapsedRealtime() - snapshot.getTimestampMs()) / 1000);
+        int metricCount = snapshot == null ? 0 : snapshot.getMetrics().size();
+        int eventCount = events == null ? 0 : events.size();
+        int trendPoints = Math.max(mTemperatureHistory.size(), mMemoryHistory.size());
+        mSampleStatsText.setText(String.format(Locale.US,
+                "App 统计：快照 %s · 指标 %d · 事件 %d · 趋势 %d 点 · 刷新成功 %d / 失败 %d",
+                ageSeconds < 0 ? "—" : ageSeconds + " 秒前",
+                metricCount, eventCount, trendPoints, mRefreshSuccessCount, mRefreshFailureCount));
+    }
