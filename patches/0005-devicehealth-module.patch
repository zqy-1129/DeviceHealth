+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.devicehealthcenter;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.view.View;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Small sparkline used by the overview screen to show recent metric values.
+ *
+ * <p>The view has no external dependencies and keeps the most recent samples
+ * provided by {@link #setSeries(List, String, String, int)}.
+ */
+public final class TrendView extends View {
+    private final Paint mBackgroundPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mGridPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mLinePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mTextPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path mPath = new Path();
+    private final List<Float> mPoints = new ArrayList<>();
+    private final float mDensity;
+
+    private String mLabel = "";
+    private String mUnit = "";
+    private int mColor = 0xFF0F766E;
+
+    public TrendView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = getResources().getDisplayMetrics().density;
+
+        mBackgroundPaint.setColor(0xFFF8FAFC);
+        mGridPaint.setColor(0xFFE2E8F0);
+        mGridPaint.setStrokeWidth(dp(1));
+        mLinePaint.setStrokeWidth(dp(2));
+        mLinePaint.setStyle(Paint.Style.STROKE);
+        mLinePaint.setStrokeJoin(Paint.Join.ROUND);
+        mLinePaint.setStrokeCap(Paint.Cap.ROUND);
+        mTextPaint.setColor(0xFF52525B);
+        mTextPaint.setTextSize(dp(11));
+    }
+
+    /**
+     * Replaces the displayed series. Non-finite samples are ignored.
+     */
+    public void setSeries(List<Float> points, String label, String unit, int color) {
+        mPoints.clear();
+        if (points != null) {
+            for (Float point : points) {
+                if (point != null && Float.isFinite(point)) {
+                    mPoints.add(point);
+                }
+            }
+        }
+        mLabel = label != null ? label : "";
+        mUnit = unit != null ? unit : "";
+        mColor = color;
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        final float width = getWidth();
+        final float height = getHeight();
+        canvas.drawRoundRect(new RectF(0, 0, width, height), dp(8), dp(8), mBackgroundPaint);
+
+        final float left = dp(46);
+        final float right = width - dp(12);
+        final float top = dp(30);
+        final float bottom = height - dp(22);
+
+        mTextPaint.setTextAlign(Paint.Align.LEFT);
+        mTextPaint.setTextSize(dp(12));
+        mTextPaint.setColor(0xFF3F3F46);
+        canvas.drawText(mLabel, dp(12), dp(18), mTextPaint);
+
+        if (mPoints.isEmpty()) {
+            mTextPaint.setTextAlign(Paint.Align.CENTER);
+            mTextPaint.setTextSize(dp(11));
+            mTextPaint.setColor(0xFF71717A);
+            canvas.drawText("暂无趋势数据", (left + right) / 2, (top + bottom) / 2, mTextPaint);
+            return;
+        }
+
+        float min = Float.MAX_VALUE;
+        float max = -Float.MAX_VALUE;
+        for (float value : mPoints) {
+            min = Math.min(min, value);
+            max = Math.max(max, value);
+        }
+        if (max - min < 0.5f) {
+            min -= 0.5f;
+            max += 0.5f;
+        }
+        final float padding = (max - min) * 0.1f;
+        min -= padding;
+        max += padding;
+
+        mTextPaint.setTextSize(dp(11));
+        mTextPaint.setTextAlign(Paint.Align.RIGHT);
+        mTextPaint.setColor(0xFF71717A);
+        for (int i = 0; i <= 2; i++) {
+            final float y = top + (bottom - top) * i / 2.0f;
+            canvas.drawLine(left, y, right, y, mGridPaint);
+            final float value = max - (max - min) * i / 2.0f;
+            canvas.drawText(format(value), left - dp(6), y + dp(4), mTextPaint);
+        }
+
+        final float latest = mPoints.get(mPoints.size() - 1);
+        mTextPaint.setTextAlign(Paint.Align.RIGHT);
+        mTextPaint.setTextSize(dp(13));
+        mTextPaint.setColor(mColor);
+        canvas.drawText(format(latest) + " " + mUnit, right, dp(18), mTextPaint);
+
+        mLinePaint.setColor(mColor);
+        mPath.reset();
+        final int count = mPoints.size();
+        for (int i = 0; i < count; i++) {
+            final float x = count == 1
+                    ? (left + right) / 2
+                    : left + (right - left) * i / (count - 1.0f);
+            final float y = bottom
+                    - (mPoints.get(i) - min) / (max - min) * (bottom - top);
+            if (i == 0) {
+                mPath.moveTo(x, y);
+            } else {
+                mPath.lineTo(x, y);
+            }
+        }
+        canvas.drawPath(mPath, mLinePaint);
+        if (count == 1) {
+            final float x = (left + right) / 2;
+            final float y = bottom
+                    - (mPoints.get(0) - min) / (max - min) * (bottom - top);
+            canvas.drawCircle(x, y, dp(3), mLinePaint);
+        }
+    }
+
+    private String format(float value) {
+        return String.format(Locale.US, "%.1f", value);
+    }
+
+    private float dp(float value) {
+        return value * mDensity;
+    }
+}
