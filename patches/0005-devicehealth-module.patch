+
+        DeviceHealthMetric hottest = null;
+        DeviceHealthMetric memory = null;
+        for (DeviceHealthMetric metric : snapshot.getMetrics()) {
+            if (metric.getId().startsWith("thermal.")
+                    && (hottest == null || metric.getValue() > hottest.getValue())) {
+                hottest = metric;
+            } else if ("memory.pressure".equals(metric.getId())) {
+                memory = metric;
+            }
+        }
+
+        mTemperatureText.setText(hottest == null ? "—" : formatValue(hottest));
+        mStateText.setText("总体状态：" + severityName(severity));
+        mStateText.setTextColor(severityColor(severity));
+        mMemoryText.setText(memory == null ? "内存压力：—" : "内存压力：" + formatValue(memory));
+
+        if (hottest != null) {
+            addHistory(mTemperatureHistory, hottest.getValue());
+        }
+        if (memory != null) {
+            addHistory(mMemoryHistory, memory.getValue());
+        }
+        updateTrend(mTemperatureTrend, mTemperatureHistory, getString(R.string.trend_temperature),
+                "°C", COLOR_ACTIVE, hottest, "温度");
+        updateTrend(mMemoryTrend, mMemoryHistory, getString(R.string.trend_memory), "%",
+                COLOR_MEMORY, memory, "内存压力");
