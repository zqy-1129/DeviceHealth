diff --git dh-b/packages/modules/DeviceHealth/tests/policy/src/com/android/server/devicehealth/PolicyEngineTest.java dh-b/packages/modules/DeviceHealth/tests/policy/src/com/android/server/devicehealth/PolicyEngineTest.java
new file mode 100644
index 0000000..ba90431
--- /dev/null
+++ dh-b/packages/modules/DeviceHealth/tests/policy/src/com/android/server/devicehealth/PolicyEngineTest.java
@@ -0,0 +1,211 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.devicehealth;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.devicehealth.DeviceHealthMetric;
+import android.devicehealth.DeviceHealthSnapshot;
+
+import org.junit.Test;
+
+import java.util.Collections;
+import java.util.List;
+
+/** Host-side unit tests for the production {@link PolicyEngine}. */
+public final class PolicyEngineTest {
+    private static final long START_MS = 100_000;
+    private static final long SAMPLE_INTERVAL_MS = 1_000;
+
+    @Test
+    public void firstNormalSampleIsQuiet() {
+        PolicyEngine engine = new PolicyEngine();
+        PolicyEngine.Result result = engine.evaluate(thermal(42.0f, START_MS), START_MS);
+        assertTrue(result.transitions.isEmpty());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_NORMAL, result.overallSeverity);
+    }
+
+    @Test
+    public void debounceHoldsWarningUntilThirdSample() {
+        PolicyEngine engine = new PolicyEngine();
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        int transitions = 0;
+        for (int i = 1; i <= 2; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            transitions += engine.evaluate(thermal(66.0f, now), now).transitions.size();
+        }
+        assertEquals(0, transitions);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result warning = engine.evaluate(thermal(66.0f, now), now);
+        assertEquals(1, warning.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_WARNING,
+                warning.transitions.get(0).toSeverity);
+        assertEquals(DeviceHealthSnapshot.SEVERITY_WARNING, warning.overallSeverity);
+    }
+
+    @Test
+    public void hysteresisClearsWarningBelowWarningClear() {
+        PolicyEngine engine = new PolicyEngine();
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+        for (int i = 0; i < 3; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            engine.evaluate(thermal(66.0f, now), now);
+        }
+
+        int transitions = 0;
+        for (int i = 0; i < 2; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            transitions += engine.evaluate(thermal(58.0f, now), now).transitions.size();
+        }
+        assertEquals(0, transitions);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result recovered = engine.evaluate(thermal(58.0f, now), now);
+        assertEquals(1, recovered.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_NORMAL,
+                recovered.transitions.get(0).toSeverity);
+    }
+
+    @Test
+    public void escalatesToCriticalOneStepAtATime() {
+        PolicyEngine engine = new PolicyEngine();
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        PolicyEngine.Result warning = null;
+        for (int i = 0; i < 3; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            warning = engine.evaluate(thermal(76.0f, now), now);
+        }
+        assertNotNull(warning);
+        assertEquals(1, warning.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_WARNING,
+                warning.transitions.get(0).toSeverity);
+
+        PolicyEngine.Result critical = null;
+        for (int i = 0; i < 3; i++) {
+            now += SAMPLE_INTERVAL_MS;
+            critical = engine.evaluate(thermal(76.0f, now), now);
+        }
+        assertNotNull(critical);
+        assertEquals(1, critical.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_WARNING,
+                critical.transitions.get(0).fromSeverity);
+        assertEquals(DeviceHealthSnapshot.SEVERITY_CRITICAL,
+                critical.transitions.get(0).toSeverity);
+    }
+
+    @Test
+    public void sampleAgesIntoStaleAndUnknown() {
+        PolicyEngine engine = new PolicyEngine();
+        List<DeviceHealthMetric> metrics = thermal(42.0f, START_MS);
+        engine.evaluate(metrics, START_MS);
+
+        PolicyEngine.Result stale = engine.evaluate(metrics, START_MS + 11_000);
+        assertEquals(1, stale.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_STALE,
+                stale.transitions.get(0).toSeverity);
+
+        PolicyEngine.Result unknown = engine.evaluate(metrics, START_MS + 31_000);
+        assertEquals(1, unknown.transitions.size());
+        assertEquals(DeviceHealthSnapshot.SEVERITY_UNKNOWN,
+                unknown.transitions.get(0).toSeverity);
+    }
+
+    @Test
+    public void unavailableDataAgesKnownMetrics() {
+        PolicyEngine engine = new PolicyEngine();
+        engine.evaluate(thermal(42.0f, START_MS), START_MS);
+
+        PolicyEngine.Result stale = engine.onDataUnavailable(START_MS + 11_000);
+        assertEquals(DeviceHealthSnapshot.SEVERITY_STALE, stale.overallSeverity);
+
+        PolicyEngine.Result unknown = engine.onDataUnavailable(START_MS + 31_000);
+        assertEquals(DeviceHealthSnapshot.SEVERITY_UNKNOWN, unknown.overallSeverity);
+    }
+
+    @Test
+    public void thresholdValidationRejectsInvalidConfigurations() {
+        assertNull(PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 3));
+        assertNotNull(PolicyEngine.validateThresholds(60.0f, 65.0f, 75.0f, 70.0f, 3));
+        assertNotNull(PolicyEngine.validateThresholds(65.0f, 60.0f, 70.0f, 75.0f, 3));
+        assertNotNull(PolicyEngine.validateThresholds(70.0f, 65.0f, 60.0f, 55.0f, 3));
+        assertNotNull(PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 0));
+        assertNotNull(PolicyEngine.validateThresholds(65.0f, 60.0f, 75.0f, 70.0f, 21));
+        assertNotNull(PolicyEngine.validateThresholds(Float.NaN, 60.0f, 75.0f, 70.0f, 3));
+    }
+
+    @Test
+    public void fastTransitionsAreRateLimited() {
+        PolicyEngine engine = new PolicyEngine();
+        engine.setThresholds("thermal.",
+                new PolicyEngine.Thresholds(65.0f, 60.0f, 75.0f, 70.0f, 1));
+        long now = START_MS;
+        engine.evaluate(thermal(42.0f, now), now);
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result warning = engine.evaluate(thermal(66.0f, now), now);
+        assertEquals(1, warning.transitions.size());
+
+        now += SAMPLE_INTERVAL_MS;
+        PolicyEngine.Result suppressed = engine.evaluate(thermal(76.0f, now), now);
+        assertTrue(suppressed.transitions.isEmpty());
+    }
+
+    @Test
+    public void thresholdsCanBeChangedAndReset() {
+        PolicyEngine engine = new PolicyEngine();
+        assertEquals("thermal.", engine.thresholdKeyFor("thermal.cpu"));
+        assertEquals("memory.pressure", engine.thresholdKeyFor("memory.pressure"));
+        assertNull(engine.thresholdKeyFor("unknown.metric"));
+
+        PolicyEngine.Thresholds custom =
+                new PolicyEngine.Thresholds(70.0f, 65.0f, 85.0f, 80.0f, 2);
+        engine.setThresholds("memory.pressure", custom);
+        PolicyEngine.Thresholds current = engine.thresholdsFor("memory.pressure");
+        assertNotNull(current);
+        assertEquals(70.0f, current.warningEnter, 0.001f);
+        assertEquals(2, current.debounceSamples);
+
+        engine.resetThresholds();
+        PolicyEngine.Thresholds defaults = engine.thresholdsFor("memory.pressure");
+        assertNotNull(defaults);
+        assertEquals(80.0f, defaults.warningEnter, 0.001f);
+        assertEquals(3, defaults.debounceSamples);
+    }
+
+    @Test
+    public void severityNamesMatchStateMachine() {
+        assertEquals("NORMAL", PolicyEngine.severityName(DeviceHealthSnapshot.SEVERITY_NORMAL));
+        assertEquals("WARNING", PolicyEngine.severityName(DeviceHealthSnapshot.SEVERITY_WARNING));
+        assertEquals("CRITICAL", PolicyEngine.severityName(DeviceHealthSnapshot.SEVERITY_CRITICAL));
+        assertEquals("STALE", PolicyEngine.severityName(DeviceHealthSnapshot.SEVERITY_STALE));
+        assertEquals("UNKNOWN", PolicyEngine.severityName(DeviceHealthSnapshot.SEVERITY_UNKNOWN));
+    }
+
+    private static List<DeviceHealthMetric> thermal(float value, long timestampMs) {
+        return Collections.singletonList(new DeviceHealthMetric("thermal.cpu", "CPU", value, "C",
+                timestampMs, /*simulated=*/false));
+    }
+}
diff --git dh-b/tools/e2e_devicehealth.sh dh-b/tools/e2e_devicehealth.sh
new file mode 100755
index 0000000..4006e88
--- /dev/null
+++ dh-b/tools/e2e_devicehealth.sh
@@ -0,0 +1,254 @@
+#!/usr/bin/env bash
+# End-to-end checks for the Device Health Center stack.
+#
+# Usage:
+#   tools/e2e_devicehealth.sh                # fast checks
+#   tools/e2e_devicehealth.sh --slow         # adds watchdog, HAL, daemon-death and App checks
+#   tools/e2e_devicehealth.sh --stabilize    # disables Wi-Fi/data first (Cuttlefish stability)
+#   tools/e2e_devicehealth.sh --permission   # adds the priv-app permission-denial check
+#
+# The permission test requires DeviceHealthDenialTest to be installed under
+# /system/priv-app. See the README for the install steps.
+#
+# Artifacts (dumpsys/logcat) are written to $OUT_DIR (default /tmp/devicehealth-e2e-*).
+set -u
+
+ADB="${ADB:-adb}"
+OUT_DIR="${OUT_DIR:-/tmp/devicehealth-e2e-$(date +%Y%m%d-%H%M%S)}"
+SLOW=0
+STABILIZE=0
+PERMISSION=0
+
+usage() {
+    echo "Usage: $0 [--slow] [--stabilize] [--permission]"
+}
+
+for arg in "$@"; do
+    case "$arg" in
+        --slow) SLOW=1 ;;
+        --stabilize) STABILIZE=1 ;;
+        --permission) PERMISSION=1 ;;
+        -h|--help) usage; exit 0 ;;
+        *) echo "Unknown option: $arg"; usage; exit 2 ;;
+    esac
+done
+
+mkdir -p "$OUT_DIR"
+CHECKS=0
+FAILURES=0
+
+say() { printf '%s\n' "$*"; }
+pass() { CHECKS=$((CHECKS + 1)); say "PASS $*"; }
+fail() { CHECKS=$((CHECKS + 1)); FAILURES=$((FAILURES + 1)); say "FAIL $*"; }
+section() { say ""; say "== $* =="; }
+
+contains() {
+    local name="$1" text="$2" needle="$3"
+    if [[ "$text" == *"$needle"* ]]; then
+        pass "$name"
+    else
+        fail "$name (missing: $needle)"
+    fi
+}
+
+matches() {
+    local name="$1" text="$2" regex="$3"
+    if printf '%s' "$text" | grep -qE "$regex"; then
+        pass "$name"
+    else
+        fail "$name (no match: $regex)"
+    fi
+}
+
+sh() { "$ADB" shell "$@" 2>&1; }
+
+if [ "$STABILIZE" = 1 ]; then
+    "$ADB" shell cmd connectivity airplane-mode enable >/dev/null 2>&1 || true
+    "$ADB" shell svc wifi disable >/dev/null 2>&1 || true
+    "$ADB" shell svc data disable >/dev/null 2>&1 || true
+fi
+
+sh cmd devicehealth debug set-daemon-capabilities reset >/dev/null 2>&1
+sh cmd devicehealth thresholds reset >/dev/null 2>&1
+
+section "Services and APEX"
+out=$(sh service check devicehealth)
+contains "framework service registered" "$out" "found"
+out=$(sh service check devicehealthd)
+contains "daemon service registered" "$out" "found"
+out=$(sh service check android.hardware.devicehealth.IDeviceHealth/default)
+contains "HAL service registered" "$out" "found"
+out=$(sh ls /system_ext/apex)
+contains "devicehealth APEX preinstalled" "$out" "com.android.devicehealth.apex"
+out=$(sh pidof devicehealthd)
+if [ -n "$(printf '%s' "$out" | tr -d '\r')" ]; then
+    pass "devicehealthd process running"
+else
+    fail "devicehealthd process running"
+fi
+
+section "Baseline diagnostics"
+dump=$(sh dumpsys devicehealth)
+contains "daemon connected" "$dump" "daemon: connected"
+contains "daemon compatibility OK" "$dump" "compatibility: OK"
+contains "unknown capabilities reported" "$dump" "unknown capabilities: none"
+contains "watchdog healthy" "$dump" "watchdog: ok"
+out=$(sh cmd devicehealth self-test)
+contains "service self-test passes" "$out" "SELF-TEST PASS"
+out=$(sh cmd devicehealth test-policy)
+contains "policy self-tests pass" "$out" "POLICY TESTS PASS"
+
+section "Runtime thresholds"
+out=$(sh cmd devicehealth thresholds)
+contains "default thermal thresholds" "$out" "thermal.: warn 65.0/60.0 crit 75.0/70.0"
+out=$(sh cmd devicehealth thresholds set memory.pressure 70 65 85 80 2)
+contains "threshold update applied" "$out" "Updated memory.pressure"
+out=$(sh settings get global devicehealth_thresholds)
+contains "threshold override persisted" "$out" "memory.pressure"
+out=$(sh 'cmd devicehealth thresholds set memory.pressure 60 65 85 80 2; echo exit=$?')
+contains "inverted thresholds rejected" "$out" "warningClear"
+contains "inverted thresholds exit code" "$out" "exit=255"
+out=$(sh cmd devicehealth thresholds set thermal.cpu 65 60 200 70 3)
+contains "out-of-range thresholds rejected" "$out" "outside"
+sh cmd devicehealth thresholds reset >/dev/null
+out=$(sh settings get global devicehealth_thresholds)
+contains "threshold override cleared" "$out" "null"
+out=$(sh cmd devicehealth thresholds)
+contains "thresholds restored" "$out" "thermal.: warn 65.0/60.0 crit 75.0/70.0"
+
+section "Policy events and notification"
+sh cmd devicehealth reset >/dev/null
+sh cmd devicehealth simulate critical thermal.cpu >/dev/null
+sleep 14
+out=$(sh cmd devicehealth history --limit 10)
+contains "warning event recorded" "$out" "NORMAL -> WARNING"
+contains "critical event recorded" "$out" "WARNING -> CRITICAL"
+out=$(sh dumpsys notification --noredact)
+contains "critical notification posted" "$out" "Device health critical"
+sh dumpsys devicehealth clear-simulated >/dev/null
+sh cmd devicehealth reset >/dev/null
+out=$(sh cmd devicehealth history)
+contains "events cleared" "$out" "No events"
+
+section "Daemon compatibility and degraded mode"
+sh cmd devicehealth debug set-daemon-version 0 >/dev/null
+out=$(sh cmd devicehealth status)
+contains "degraded compatibility reported" "$out" "TOO_OLD"
+out=$(sh 'cmd devicehealth simulate critical thermal.cpu; echo exit=$?')
+contains "simulation disabled in degraded mode" "$out" "disabled"
+contains "degraded simulation exit code" "$out" "exit=255"
+sh cmd devicehealth debug set-daemon-version reset >/dev/null
+out=$(sh cmd devicehealth status)
+contains "compatibility restored" "$out" "OK"
+
+section "Sampling interval (daemon v2)"
+out=$(sh cmd devicehealth daemon-interval 1000)
+contains "sampling interval applied" "$out" "set to 1000ms"
+out=$(sh 'cmd devicehealth daemon-interval 100; echo exit=$?')
+contains "invalid sampling interval rejected" "$out" "between 500 and 30000"
+contains "invalid sampling interval exit code" "$out" "exit=255"
+sh cmd devicehealth daemon-interval reset >/dev/null
+
+if [ "$SLOW" = 1 ]; then
+    section "Watchdog"
+    sh logcat -c
+    sh cmd devicehealth debug stall 22000 >/dev/null
+    sleep 21
+    out=$(sh logcat -d -s DeviceHealthService)
+    contains "watchdog detects the stall" "$out" "Watchdog: evaluation loop stalled"
+    sleep 8
+    dump=$(sh dumpsys devicehealth)
+    matches "watchdog trips recorded" "$dump" "trips [1-9]"
+    matches "watchdog auto-recovery recorded" "$dump" "recoveries [1-9]"
+    out=$(sh logcat -d -s DeviceHealthService)
+    contains "watchdog logs recovery" "$out" "Watchdog: evaluation loop recovered"
+
+    section "Capability reporting"
+    sh cmd devicehealth debug set-daemon-capabilities 0x7 >/dev/null
+    sleep 3
+    out=$(sh cmd devicehealth status)
+    contains "unknown capability bits reported" "$out" "unknown capabilities: 0x4"
+    contains "capability override visible" "$out" "daemon capabilities override: 0x7 (debug)"
+    out=$(sh cmd devicehealth self-test)
+    contains "self-test warns about unknown capabilities" "$out" "WARN capabilities: unknown bits 0x4"
+    sh cmd devicehealth debug set-daemon-capabilities reset >/dev/null
+    sleep 3
+    out=$(sh cmd devicehealth status)
+    contains "unknown capabilities cleared" "$out" "unknown capabilities: none"
+
+    section "HAL failure and recovery"
+    "$ADB" root >/dev/null 2>&1
+    sleep 2
+    sh stop vendor.devicehealth-default >/dev/null
+    sleep 14
+    out=$(sh cmd devicehealth status)
+    contains "framework reports STALE without the HAL" "$out" "state: STALE"
+    sh start vendor.devicehealth-default >/dev/null
+    sleep 10
+    out=$(sh cmd devicehealth status)
+    contains "framework recovers with the HAL" "$out" "state: NORMAL"
+
+    section "Daemon death and reconnect"
+    pid=$(sh pidof devicehealthd | tr -d '\r')
+    if [ -n "$pid" ]; then
+        sh kill -9 "$pid" >/dev/null 2>&1
+        sleep 8
+        out=$(sh service check devicehealthd)
+        contains "daemon restarted by init" "$out" "found"
+        out=$(sh cmd devicehealth status)
+        contains "framework reconnected to the daemon" "$out" "daemon: connected version=2"
+    else
+        fail "devicehealthd pid available"
+    fi
+
+    section "App listener lifecycle"
+    sh input keyevent KEYCODE_WAKEUP >/dev/null 2>&1
+    sh wm dismiss-keyguard >/dev/null 2>&1
+    sh am start -n com.android.devicehealthcenter/.MainActivity >/dev/null 2>&1
+    sleep 5
+    dump=$(sh dumpsys devicehealth)
+    contains "app registers a listener" "$dump" "listeners: 1"
+    sh input keyevent KEYCODE_HOME >/dev/null 2>&1
+    sleep 4
+    dump=$(sh dumpsys devicehealth)
+    contains "app unregisters on stop" "$dump" "listeners: 0"
+fi
+
+if [ "$PERMISSION" = 1 ]; then
+    section "Permission denial"
+    out=$(sh pm path com.android.devicehealthcenter.denialtest)
+    contains "denial test app installed" "$out" "priv-app/DeviceHealthDenialTest"
+    granted=$(sh dumpsys package com.android.devicehealthcenter.denialtest | grep -c \
+            "MANAGE_DEVICE_HEALTH")
+    if [ "$granted" = "0" ]; then
+        pass "MANAGE_DEVICE_HEALTH is not granted"
+    else
+        fail "MANAGE_DEVICE_HEALTH is not granted (found $granted references)"
+    fi
+    sh logcat -c
+    sh am force-stop com.android.devicehealthcenter.denialtest >/dev/null 2>&1
+    sh am start -n com.android.devicehealthcenter.denialtest/.DenialActivity >/dev/null 2>&1
+    sleep 3
+    out=$(sh logcat -d -s DHC_DENIAL_TEST)
+    contains "unprivileged API calls denied" "$out" "RESULT=PASS"
+    matches "getSnapshot denied" "$out" "getSnapshot=DENIED"
+    matches "registerListener denied" "$out" "registerListener=DENIED"
+    matches "clearEvents denied" "$out" "clearEvents=DENIED"
+    sh am force-stop com.android.devicehealthcenter.denialtest >/dev/null 2>&1
+fi
+
+sh cmd devicehealth reset >/dev/null
+sh cmd devicehealth daemon-interval reset >/dev/null 2>&1
+sh cmd devicehealth debug set-daemon-version reset >/dev/null 2>&1
+
+sh dumpsys devicehealth >"$OUT_DIR/dumpsys.txt" 2>&1
+sh logcat -d -s DeviceHealthService devicehealthd >"$OUT_DIR/logcat.txt" 2>&1
+
+say ""
+say "Artifacts: $OUT_DIR"
+if [ "$FAILURES" -eq 0 ]; then
+    say "E2E PASS ($CHECKS checks)"
+    exit 0
+fi
+say "E2E FAIL ($FAILURES failed / $CHECKS checks)"
+exit 1
diff --git dh-b/tools/fault_matrix.sh dh-b/tools/fault_matrix.sh
new file mode 100755
index 0000000..a676891
--- /dev/null
+++ dh-b/tools/fault_matrix.sh
@@ -0,0 +1,479 @@
+#!/usr/bin/env bash
+# Deterministic fault matrix for the Device Health Center stack.
+#
+# Every scenario injects a real fault and asserts the framework recovers:
+#   1. daemon SIGSTOP          framework -> daemon binder call wedges
+#   2. HAL SIGSTOP             daemon -> HAL binder call wedges, cached data ages out
+#   3. framework lock hold     real monitor contention on the evaluation thread
+#   4. NEWER daemon version    forward-compatibility skew
+#   5. TOO_OLD daemon version  degraded mode disables simulation
+#   6. HAL death               init stop/start, daemon stays up
+#   7. daemon death             kill -9, init restart, framework reconnect
+#
+# Usage:
+#   tools/fault_matrix.sh                  # all non-destructive scenarios
+#   tools/fault_matrix.sh --permission     # + permission-denial checks
+#   tools/fault_matrix.sh --persistence    # + threshold persistence across reboots
+#   tools/fault_matrix.sh --apex-missing   # + real APEX removal/restore (reboots)
+#
+# The APEX scenario removes /system_ext/apex/com.android.devicehealth.apex through
+# overlayfs, reboots, asserts the degraded state, then restores the APEX and reboots
+# again. An EXIT trap restores the APEX if the script is interrupted.
+#
+# Artifacts (dumpsys/logcat) are written to $OUT_DIR (default /tmp/devicehealth-faults-*).
+set -u
+
+ADB="${ADB:-adb}"
+OUT_DIR="${OUT_DIR:-/tmp/devicehealth-faults-$(date +%Y%m%d-%H%M%S)}"
+PERMISSION=0
+PERSISTENCE=0
+APEX_MISSING=0
+APEX_REMOVED=0
+APEX_BACKUP=/data/local/tmp/com.android.devicehealth.apex.bak
+DAEMON_STOPPED_PID=""
+HAL_STOPPED_PID=""
+
+usage() {
+    echo "Usage: $0 [--permission] [--persistence] [--apex-missing]"
+}
+
+for arg in "$@"; do
+    case "$arg" in
+        --permission) PERMISSION=1 ;;
+        --persistence) PERSISTENCE=1 ;;
+        --apex-missing) APEX_MISSING=1 ;;
+        -h|--help) usage; exit 0 ;;
+        *) echo "Unknown option: $arg"; usage; exit 2 ;;
+    esac
+done
+
+mkdir -p "$OUT_DIR"
+CHECKS=0
+FAILURES=0
+
+say() { printf '%s\n' "$*"; }
+pass() { CHECKS=$((CHECKS + 1)); say "PASS $*"; }
+fail() { CHECKS=$((CHECKS + 1)); FAILURES=$((FAILURES + 1)); say "FAIL $*"; }
+section() { say ""; say "== $* =="; }
+
+contains() {
+    local name="$1" text="$2" needle="$3"
+    if [[ "$text" == *"$needle"* ]]; then
+        pass "$name"
+    else
+        fail "$name (missing: $needle)"
+    fi
+}
+
+matches() {
+    local name="$1" text="$2" regex="$3"
+    if printf '%s' "$text" | grep -qE "$regex"; then
+        pass "$name"
+    else
+        fail "$name (no match: $regex)"
+    fi
+}
+
+sh() { "$ADB" shell "$@" 2>&1; }
+
+wait_for_boot() {
+    "$ADB" wait-for-device
+    sh 'while [ "$(getprop sys.boot_completed)" != "1" ]; do sleep 2; done' >/dev/null
+    sleep 3
+}
+
+# Polls `cmd devicehealth status` until it reports the requested state.
+wait_for_state() {
+    local want="$1" timeout="${2:-25}"
+    local deadline=$((SECONDS + timeout))
+    while [ "$SECONDS" -lt "$deadline" ]; do
+        STATUS_OUT=$(sh cmd devicehealth status)
+        if printf '%s' "$STATUS_OUT" | grep -q "state: $want"; then
+            return 0
+        fi
+        sleep 1
+    done
+    return 1
+}
+
+wait_for_text() {
+    local needle="$1" timeout="${2:-20}"
+    local deadline=$((SECONDS + timeout))
+    while [ "$SECONDS" -lt "$deadline" ]; do
+        TEXT_OUT=$(sh logcat -d -s DeviceHealthService devicehealthd)
+        if printf '%s' "$TEXT_OUT" | grep -q "$needle"; then
+            return 0
+        fi
+        sleep 1
+    done
+    return 1
+}
+
+daemon_pid() { sh pidof devicehealthd | tr -d '\r'; }
+hal_pid() { sh pidof com.android.hardware.devicehealth | tr -d '\r'; }
+daemon_timeouts() {
+    sh cmd devicehealth status | grep -o 'daemon timeouts [0-9]*' | awk '{print $3}'
+}
+
+restore_apex() {
+    [ "$APEX_REMOVED" = 1 ] || return 0
+    say "Restoring the devicehealth APEX"
+    "$ADB" root >/dev/null 2>&1
+    "$ADB" wait-for-device
+    sh remount >/dev/null 2>&1
+    sh cp "$APEX_BACKUP" /system_ext/apex/com.android.devicehealth.apex >/dev/null 2>&1
+    sh reboot >/dev/null 2>&1
+    wait_for_boot
+    APEX_REMOVED=0
+}
+
+cleanup() {
+    # Never leave a SIGSTOPped process behind, even when a check aborts the run.
+    if [ -n "$DAEMON_STOPPED_PID" ]; then
+        sh kill -CONT "$DAEMON_STOPPED_PID" >/dev/null 2>&1
+    fi
+    if [ -n "$HAL_STOPPED_PID" ]; then
+        sh kill -CONT "$HAL_STOPPED_PID" >/dev/null 2>&1
+    fi
+    restore_apex
+}
+trap cleanup EXIT
+
+"$ADB" root >/dev/null 2>&1
+"$ADB" wait-for-device
+sleep 2
+sh cmd devicehealth debug set-daemon-version reset >/dev/null 2>&1
+sh cmd devicehealth debug set-daemon-capabilities reset >/dev/null 2>&1
+sh cmd devicehealth debug reset-watchdog >/dev/null 2>&1
+sh cmd devicehealth thresholds reset >/dev/null 2>&1
+sh cmd devicehealth clear-simulated >/dev/null 2>&1
+
+section "Baseline"
+if wait_for_state NORMAL 40; then
+    pass "baseline reaches NORMAL"
+else
+    fail "baseline reaches NORMAL (state: ${STATUS_OUT%%$'\n'*})"
+fi
+out=$(sh cmd devicehealth status)
+contains "baseline state NORMAL" "$out" "state: NORMAL"
+contains "baseline daemon connected" "$out" "daemon: connected version=2"
+contains "baseline compatibility OK" "$out" "compatibility: OK"
+
+section "Fault: daemon SIGSTOP (framework -> daemon binder wedge)"
+sh cmd devicehealth reset >/dev/null
+sh logcat -c
+dpid=$(daemon_pid)
+if [ -z "$dpid" ]; then
+    fail "devicehealthd pid available"
+else
+    before=$(daemon_timeouts)
+    sh kill -STOP "$dpid"
+    DAEMON_STOPPED_PID="$dpid"
+    if wait_for_state STALE 25; then
+        pass "daemon SIGSTOP drives the framework to STALE"
+    else
+        fail "daemon SIGSTOP drives the framework to STALE (${STATUS_OUT%%$'\n'*})"
+    fi
+    out=$(sh cmd devicehealth status)
+    contains "daemon reported unavailable while stopped" "$out" "daemon: unavailable"
+    after=$(daemon_timeouts)
+    if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -gt "$before" ]; then
+        pass "daemon timeouts increased ($before -> $after)"
+    else
+        fail "daemon timeouts increased ($before -> $after)"
+    fi
+    out=$(sh logcat -d -s DeviceHealthService)
+    contains "framework logs the bounded binder timeout" "$out" "timed out after 1500ms"
+    sh kill -CONT "$dpid"
+    DAEMON_STOPPED_PID=""
+    if wait_for_state NORMAL 25; then
+        pass "daemon SIGCONT restores NORMAL"
+    else
+        fail "daemon SIGCONT restores NORMAL"
+    fi
+fi
+
+section "Fault: HAL SIGSTOP (daemon -> HAL binder wedge)"
+sh cmd devicehealth reset >/dev/null
+sh logcat -c
+hpid=$(hal_pid)
+if [ -z "$hpid" ]; then
+    fail "device health HAL pid available"
+else
+    before=$(daemon_timeouts)
+    sh kill -STOP "$hpid"
+    HAL_STOPPED_PID="$hpid"
+    if wait_for_state STALE 30; then
+        pass "HAL SIGSTOP ages the cached snapshot into STALE"
+    else
+        fail "HAL SIGSTOP ages the cached snapshot into STALE (${STATUS_OUT%%$'\n'*})"
+    fi
+    out=$(sh cmd devicehealth status)
+    contains "daemon still connected during HAL wedge" "$out" "daemon: connected version=2"
+    after=$(daemon_timeouts)
+    if [ -n "$before" ] && [ -n "$after" ] && [ "$after" -eq "$before" ]; then
+        pass "no framework-level timeout during HAL wedge ($after)"
+    else
+        fail "no framework-level timeout during HAL wedge ($before -> $after)"
+    fi
+    sh kill -CONT "$hpid"
+    HAL_STOPPED_PID=""
+    if wait_for_state NORMAL 30; then
+        pass "HAL SIGCONT restores NORMAL"
+    else
+        fail "HAL SIGCONT restores NORMAL"
+    fi
+fi
+
+section "Fault: framework lock contention"
+sh logcat -c
+sh cmd devicehealth debug reset-watchdog >/dev/null
+sh cmd devicehealth debug hold-lock 22000 >/dev/null
+sleep 23
+if wait_for_text "evaluation loop stalled" 10; then
+    pass "watchdog detects the stalled evaluation loop"
+else
+    fail "watchdog detects the stalled evaluation loop"
+fi
+out=$(sh logcat -d -s DeviceHealthService)
+contains "watchdog restarts the evaluation loop" "$out" "restarted evaluation loop"
+if wait_for_text "evaluation loop recovered" 15; then
+    pass "watchdog logs recovery"
+else
+    fail "watchdog logs recovery"
+fi
+dump=$(sh dumpsys devicehealth)
+matches "watchdog trips recorded" "$dump" "trips [1-9]"
+matches "watchdog recoveries recorded" "$dump" "recoveries [1-9]"
+if wait_for_state NORMAL 20; then
+    pass "state NORMAL after lock contention"
+else
+    fail "state NORMAL after lock contention"
+fi
+
+section "Fault: NEWER daemon version"
+sh cmd devicehealth debug set-daemon-version 3 >/dev/null
+out=$(sh cmd devicehealth status)
+contains "NEWER compatibility reported" "$out" "compatibility: NEWER"
+contains "version override visible" "$out" "daemon version override: 3 (debug)"
+sh cmd devicehealth debug set-daemon-version reset >/dev/null
+out=$(sh cmd devicehealth status)
+contains "NEWER override cleared" "$out" "compatibility: OK"
+if printf '%s' "$out" | grep -q "daemon version override"; then
+    fail "version override removed"
+else
+    pass "version override removed"
+fi
+
+section "Fault: unknown capability bits"
+sh logcat -c
+sh cmd devicehealth debug set-daemon-capabilities 0x7 >/dev/null
+sleep 2
+out=$(sh cmd devicehealth status)
+contains "unknown capability bits reported" "$out" "unknown capabilities: 0x4"
+contains "capability override visible" "$out" "daemon capabilities override: 0x7 (debug)"
+if wait_for_text "reports unknown capabilities 0x4" 10; then
+    pass "framework logs the unknown capability bits"
+else
+    fail "framework logs the unknown capability bits"
+fi
+sh cmd devicehealth debug set-daemon-capabilities reset >/dev/null
+sleep 2
+out=$(sh cmd devicehealth status)
+contains "unknown capabilities cleared" "$out" "unknown capabilities: none"
+
+section "Fault: TOO_OLD daemon version"
+sh cmd devicehealth debug set-daemon-version 0 >/dev/null
+out=$(sh cmd devicehealth status)
+contains "TOO_OLD compatibility reported" "$out" "compatibility: TOO_OLD"
+out=$(sh 'cmd devicehealth simulate critical thermal.cpu; echo exit=$?')
+contains "simulation disabled in degraded mode" "$out" "disabled"
+contains "degraded simulation exit code" "$out" "exit=255"
+sh cmd devicehealth debug set-daemon-version reset >/dev/null
+out=$(sh cmd devicehealth status)
+contains "TOO_OLD override cleared" "$out" "compatibility: OK"
+
+section "Fault: HAL death (init stop)"
+sh cmd devicehealth reset >/dev/null
+sh logcat -c
+out=$(sh stop vendor.devicehealth-default)
+if printf '%s' "$out" | grep -qi "does not exist\|unknown service"; then
+    fail "HAL init service stopped ($out)"
+else
+    pass "HAL init service stopped"
+fi
+if wait_for_text "HAL binder died" 15; then
+    pass "daemon death recipient reports the HAL death"
+else
+    fail "daemon death recipient reports the HAL death"
+fi
+out=$(sh cmd devicehealth status)
+contains "daemon stays connected after HAL death" "$out" "daemon: connected version=2"
+if wait_for_state STALE 30; then
+    pass "framework reports STALE after HAL death"
+else
+    fail "framework reports STALE after HAL death"
+fi
+sh start vendor.devicehealth-default >/dev/null
+if wait_for_state NORMAL 30; then
+    pass "framework recovers after HAL restart"
+else
+    fail "framework recovers after HAL restart"
+fi
+
+section "Fault: daemon death and reconnect"
+sh logcat -c
+dpid=$(daemon_pid)
+if [ -z "$dpid" ]; then
+    fail "devicehealthd pid available before kill"
+else
+    sh kill -9 "$dpid" >/dev/null 2>&1
+    if wait_for_text "devicehealthd died" 10; then
+        pass "framework death recipient reports the daemon death"
+    else
+        fail "framework death recipient reports the daemon death"
+    fi
+    deadline=$((SECONDS + 30))
+    newpid=""
+    while [ "$SECONDS" -lt "$deadline" ]; do
+        newpid=$(daemon_pid)
+        if [ -n "$newpid" ] && [ "$newpid" != "$dpid" ]; then
+            break
+        fi
+        sleep 1
+    done
+    if [ -n "$newpid" ] && [ "$newpid" != "$dpid" ]; then
+        pass "init restarted devicehealthd ($dpid -> $newpid)"
+    else
+        fail "init restarted devicehealthd"
+    fi
+    deadline=$((SECONDS + 30))
+    while [ "$SECONDS" -lt "$deadline" ]; do
+        out=$(sh cmd devicehealth status)
+        if printf '%s' "$out" | grep -q "daemon: connected version=2"; then
+            break
+        fi
+        sleep 1
+    done
+    contains "framework reconnected to the new daemon" "$out" "daemon: connected version=2"
+    if wait_for_state NORMAL 30; then
+        pass "state NORMAL after daemon restart"
+    else
+        fail "state NORMAL after daemon restart"
+    fi
+fi
+
+if [ "$PERMISSION" = 1 ]; then
+    section "Fault: permission denial"
+    out=$(sh pm path com.android.devicehealthcenter.denialtest)
+    contains "denial test app installed" "$out" "priv-app/DeviceHealthDenialTest"
+    granted=$(sh dumpsys package com.android.devicehealthcenter.denialtest | grep -c \
+            "MANAGE_DEVICE_HEALTH")
+    if [ "$granted" = "0" ]; then
+        pass "MANAGE_DEVICE_HEALTH is not granted"
+    else
+        fail "MANAGE_DEVICE_HEALTH is not granted (found $granted references)"
+    fi
+    sh logcat -c
+    sh am force-stop com.android.devicehealthcenter.denialtest >/dev/null 2>&1
+    sh am start -n com.android.devicehealthcenter.denialtest/.DenialActivity >/dev/null 2>&1
+    sleep 3
+    out=$(sh logcat -d -s DHC_DENIAL_TEST)
+    contains "unprivileged API calls denied" "$out" "RESULT=PASS"
+    matches "getSnapshot denied" "$out" "getSnapshot=DENIED"
+    matches "registerListener denied" "$out" "registerListener=DENIED"
+    matches "clearEvents denied" "$out" "clearEvents=DENIED"
+    sh am force-stop com.android.devicehealthcenter.denialtest >/dev/null 2>&1
+fi
+
+if [ "$PERSISTENCE" = 1 ]; then
+    section "Fault: threshold persistence across reboot"
+    sh cmd devicehealth thresholds set thermal.cpu 61 56 71 66 4 >/dev/null
+    out=$(sh settings get global devicehealth_thresholds)
+    contains "threshold override written to settings" "$out" "61"
+    out=$(sh cmd devicehealth thresholds)
+    contains "override active before reboot" "$out" \
+            "thermal.: warn 61.0/56.0 crit 71.0/66.0 debounce 4"
+    # SettingsProvider persists asynchronously; give it time before rebooting.
+    sleep 5
+    sh reboot >/dev/null
+    wait_for_boot
+    out=$(sh cmd devicehealth thresholds)
+    contains "override restored after reboot" "$out" \
+            "thermal.: warn 61.0/56.0 crit 71.0/66.0 debounce 4"
+    if wait_for_text "Restored 2 persisted threshold override" 15; then
+        pass "framework logs threshold restoration"
+    else
+        fail "framework logs threshold restoration"
+    fi
+    sh cmd devicehealth thresholds reset >/dev/null
+    out=$(sh settings get global devicehealth_thresholds)
+    contains "reset clears persisted override" "$out" "null"
+    sleep 5
+    sh reboot >/dev/null
+    wait_for_boot
+    out=$(sh cmd devicehealth thresholds)
+    contains "defaults restored after second reboot" "$out" \
+            "thermal.: warn 65.0/60.0 crit 75.0/70.0"
+fi
+
+if [ "$APEX_MISSING" = 1 ]; then
+    section "Fault: APEX missing (real removal + reboot)"
+    # Earlier reboot scenarios can leave adbd unrooted; remount needs root.
+    "$ADB" root >/dev/null 2>&1
+    "$ADB" wait-for-device
+    sleep 2
+    sh remount >/dev/null 2>&1
+    sh cp /system_ext/apex/com.android.devicehealth.apex "$APEX_BACKUP" >/dev/null
+    sh rm /system_ext/apex/com.android.devicehealth.apex
+    if [ -z "$(sh 'ls /system_ext/apex/com.android.devicehealth.apex 2>/dev/null')" ]; then
+        pass "devicehealth APEX removed"
+    else
+        fail "devicehealth APEX removed"
+    fi
+    APEX_REMOVED=1
+    sh reboot >/dev/null
+    wait_for_boot
+    out=$(sh pm list packages --apex-only --show-versioncode)
+    if printf '%s' "$out" | grep -q "com.android.devicehealth"; then
+        fail "APEX absent from package list"
+    else
+        pass "APEX absent from package list"
+    fi
+    out=$(sh cmd devicehealth status)
+    contains "framework degrades to UNKNOWN" "$out" "state: UNKNOWN"
+    contains "daemon reported unavailable" "$out" "daemon: unavailable"
+    contains "compatibility UNAVAILABLE" "$out" "compatibility: UNAVAILABLE"
+    out=$(sh cmd devicehealth self-test)
+    contains "framework self-test fails without the daemon" "$out" "SELF-TEST FAIL"
+    restore_apex
+    deadline=$((SECONDS + 20))
+    while [ "$SECONDS" -lt "$deadline" ]; do
+        out=$(sh pm list packages --apex-only --show-versioncode)
+        if printf '%s' "$out" | grep -q "com.android.devicehealth versionCode:1"; then
+            break
+        fi
+        sleep 1
+    done
+    contains "APEX restored" "$out" "com.android.devicehealth versionCode:1"
+    if wait_for_state NORMAL 30; then
+        pass "state NORMAL after APEX restore"
+    else
+        fail "state NORMAL after APEX restore"
+    fi
+fi
+
+sh cmd devicehealth reset >/dev/null 2>&1
+sh cmd devicehealth debug set-daemon-version reset >/dev/null 2>&1
+sh cmd devicehealth debug reset-watchdog >/dev/null 2>&1
+sh dumpsys devicehealth >"$OUT_DIR/dumpsys.txt" 2>&1
+sh logcat -d -s DeviceHealthService devicehealthd >"$OUT_DIR/logcat.txt" 2>&1
+
+say ""
+say "Artifacts: $OUT_DIR"
+if [ "$FAILURES" -eq 0 ]; then
+    say "FAULT MATRIX PASS ($CHECKS checks)"
+    exit 0
+fi
+say "FAULT MATRIX FAIL ($FAILURES failed / $CHECKS checks)"
+exit 1
