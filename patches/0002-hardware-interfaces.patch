+
+package android.hardware.devicehealth;
+
+/**
+ * A single health metric sample provided by a vendor health sensor.
+ */
+@JavaDerive(toString=true)
+@VintfStability
+parcelable MetricSample {
+    /** Stable identifier, for example "thermal.zone0". */
+    String id;
+
+    /** Human-readable name, for example "CPU". */
+    String name;
+
+    /** Numeric value expressed in {@link #unit}. */
+    float value;
+
+    /** Unit of the value, for example "C" or "percent". */
+    String unit;
+
+    /** Timestamp in milliseconds since boot. */
+    long timestampMs;
+
+    /** True when the value is simulated rather than read from hardware. */
+    boolean simulated;
+}
