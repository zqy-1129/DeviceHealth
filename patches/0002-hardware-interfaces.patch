+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "DeviceHealth.h"
+
+#include <android-base/file.h>
+#include <android-base/logging.h>
+#include <android-base/strings.h>
+
+#include <glob.h>
+#include <time.h>
+
+#include <cstdlib>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace aidl::android::hardware::devicehealth {
+
+namespace {
+
+int64_t nowMs() {
+    timespec ts{};
+    clock_gettime(CLOCK_BOOTTIME, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+std::string zoneId(const std::string& path) {
+    const auto slash = path.find_last_of('/');
+    return "thermal." + (slash == std::string::npos ? path : path.substr(slash + 1));
+}
+
+MetricSample makeSample(const std::string& id, const std::string& name, float value,
+                        bool simulated) {
+    MetricSample sample;
+    sample.id = id;
+    sample.name = name;
+    sample.value = value;
+    sample.unit = "C";
+    sample.timestampMs = nowMs();
+    sample.simulated = simulated;
+    return sample;
+}
+
+}  // namespace
+
+std::vector<MetricSample> DeviceHealth::readThermalZones() {
+    std::vector<MetricSample> samples;
+
+    glob_t globResult{};
+    const int ret = glob("/sys/class/thermal/thermal_zone*", GLOB_NOSORT, nullptr, &globResult);
+    if (ret != 0) {
+        if (ret != GLOB_NOMATCH) {
+            LOG(WARNING) << "Unable to enumerate thermal zones: " << ret;
+        }
+        return samples;
+    }
+
+    for (size_t i = 0; i < globResult.gl_pathc; ++i) {
+        const std::string dir = globResult.gl_pathv[i];
+
+        std::string type;
+        std::string tempRaw;
+        if (!::android::base::ReadFileToString(dir + "/type", &type) ||
+            !::android::base::ReadFileToString(dir + "/temp", &tempRaw)) {
+            continue;
+        }
+
+        type = ::android::base::Trim(type);
+        tempRaw = ::android::base::Trim(tempRaw);
+
+        char* end = nullptr;
+        const float milliCelsius = std::strtof(tempRaw.c_str(), &end);
+        if (end == tempRaw.c_str()) {
+            LOG(WARNING) << "Invalid temperature in " << dir << ": " << tempRaw;
+            continue;
+        }
+
+        const std::string id = zoneId(dir);
+        samples.push_back(makeSample(id, type.empty() ? id : type, milliCelsius / 1000.0f,
+                                     /*simulated=*/false));
+    }
+
+    globfree(&globResult);
+    return samples;
+}
+
+std::vector<MetricSample> DeviceHealth::simulatedSamples() {
+    return {
+            makeSample("thermal.cpu", "CPU", 42.0f, /*simulated=*/true),
+            makeSample("thermal.gpu", "GPU", 43.0f, /*simulated=*/true),
+            makeSample("thermal.battery", "Battery", 38.0f, /*simulated=*/true),
+    };
+}
+
+ndk::ScopedAStatus DeviceHealth::getMetrics(std::vector<MetricSample>* out) {
+    auto samples = readThermalZones();
+    if (samples.empty()) {
+        LOG(WARNING) << "No usable thermal zones found; returning simulated samples";
+        samples = simulatedSamples();
+    }
+    *out = std::move(samples);
+    return ndk::ScopedAStatus::ok();
+}
+
+}  // namespace aidl::android::hardware::devicehealth
