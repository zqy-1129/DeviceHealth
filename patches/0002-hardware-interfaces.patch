+package android.hardware.devicehealth;
+
+import android.hardware.devicehealth.MetricSample;
+
+/**
+ * Provides raw health metric samples from the vendor.
+ *
+ * <p>Implementations must return the latest available samples. If a sensor is
+ * unavailable, the implementation may return a simulated sample with
+ * {@link MetricSample#simulated} set to true. Policy decisions, thresholds and
+ * history are intentionally handled by the framework, not by this HAL.
+ */
+@VintfStability
+interface IDeviceHealth {
+    /**
+     * Returns the latest metric samples.
+     *
+     * @return a non-empty list of samples, or an empty list if no data is
+     *     available at all.
+     */
+    MetricSample[] getMetrics();
+}
